//@version=6
// ============================================================================
// Vein Trend [WavesUnchained]
// Version: 0.3.0
// Author: WavesUnchained
// Build: 2026-11-17
// ============================================================================
// Trend-state display for the Vein suite. Works on any timeframe.
// Colors candles by EMA direction and efficiency ratio and marks the
// structural events (BOS/CHoCH, Spring/Upthrust, climax sequence) that
// change the swing structure. It shows where the market stands — it does
// not issue buy/sell signals.
//
// Features:
//   ✓ Candle-state heatmap: EMA20/50 direction × efficiency ratio, range, conflict
//   ✓ Micro / major swing structure with BOS and CHoCH
//   ✓ Spring / Upthrust (fake break with wick, close back inside)
//   ✓ Climax sequence state machine (CLX → reaction → test → BOS)
//   ✓ Premium / discount position inside the major swing range
//   ✓ Event alerts: candle-state change, major BOS, major CHoCH
//
// Data Contract:
//   Price:     REQUIRED   chart symbol
//   Volume:    OPTIONAL   real trade volume only — climax volume check degrades to range-only
//   OI:        NO
//   Reference: NO
//   Verdict:   CFD-degraded
//
// ============================================================================
indicator("Vein: Trend [WavesUnchained]", "Vein Trend", overlay=true, max_labels_count=500)

// ============================================================================
// INPUTS — Indicators
// ============================================================================

var gInd = "Indicator Parameters"
int   emaFastLen     = input.int(20,    "EMA Fast",               minval=1,    group=gInd)
int   emaSlowLen     = input.int(50,    "EMA Slow",               minval=1,    group=gInd)
int   atrLen         = input.int(14,    "ATR Length",             minval=1,    group=gInd)
int   bbLen          = input.int(20,    "BB Length",              minval=1,    group=gInd)
float bbMult         = input.float(2.0, "BB Multiplier",          minval=0.5,  step=0.1, group=gInd)
int   volAvgLen      = input.int(20,    "Volume Average Length",  minval=5,    group=gInd)

// ============================================================================
// INPUTS — Structure
// ============================================================================

var gSwing = "Swing / Structure"
int   leftBars       = input.int(3,    "Micro Pivot Left",    minval=1,   group=gSwing)
int   rightBars      = input.int(3,    "Micro Pivot Right",   minval=1,   group=gSwing)
int   majLeftBars    = input.int(7,    "Major Pivot Left",    minval=3,   group=gSwing)
int   majRightBars   = input.int(7,    "Major Pivot Right",   minval=3,   group=gSwing)
float minWickRatio   = input.float(0.35, "Spring/UT Wick Ratio", minval=0.1, step=0.05, group=gSwing)
float minCandleATR   = input.float(0.5,  "Spring/UT Candle/ATR", minval=0.1, step=0.1,  group=gSwing)
float climaxRangeATR = input.float(1.8,  "Climax Range/ATR",     minval=1.0, step=0.1,  group=gSwing)
float climaxVolFact  = input.float(1.8,  "Climax Vol Factor",    minval=1.0, step=0.1,  group=gSwing)

// ============================================================================
// INPUTS — Display
// ============================================================================

var gDisplay = "Display"
bool showTable        = input.bool(true,  "Show State Table",    group=gDisplay)
string tablePos       = input.string("top_right", "Table Position", options=["top_left","top_center","top_right","middle_left","middle_center","middle_right","bottom_left","bottom_center","bottom_right"], group=gDisplay)
bool showCandleColors = input.bool(true,  "Candle Color Heatmap", group=gDisplay, tooltip="Colors candles by market state:\n\nUP / DOWN STRONG: EMA20 above / below EMA50, efficiency ratio ≥ 0.5\nUP / DOWN: EMA20 above / below EMA50, efficiency ratio 0.35–0.5\nRANGE: efficiency ratio ≤ 0.35\nCONFLICT: EMA direction opposite to the last major BOS direction\nFLAT: EMA20 = EMA50 or not enough data")
bool showEvents       = input.bool(true,  "Show Structure Events", group=gDisplay, tooltip="Markers for major BOS / CHoCH, Spring / Upthrust (micro and major) and a completed climax sequence.")
color bullColor       = input.color(color.new(#00c853, 0), "Bull Event Color", group=gDisplay)
color bearColor       = input.color(color.new(#d50000, 0), "Bear Event Color", group=gDisplay)

// ============================================================================
// CALCULATIONS — Base Indicators
// ============================================================================

float ema20 = ta.ema(close, emaFastLen)
float ema50 = ta.ema(close, emaSlowLen)
float atr14 = ta.atr(atrLen)

// Echtes Handelsvolumen? Nur "tick" schließt aus; "n/a" zählt, wenn der Feed Volumen liefert (DATA_VALIDITY §2).
bool volumeIsReal = (ta.cum(nz(volume)) > 0 and syminfo.volumetype != "tick") and not na(volume)

float avgVol_calc = ta.sma(volume, volAvgLen)
float avgVol = volumeIsReal ? avgVol_calc : na

float bbBasis = ta.sma(close, bbLen)
float bbDev   = ta.stdev(close, bbLen) * bbMult
float bbUpper = bbBasis + bbDev
float bbLower = bbBasis - bbDev

float candleRange    = high - low
float upperWick      = high - math.max(open, close)
float lowerWick      = math.min(open, close) - low
float upperWickRatio = candleRange > 0 ? upperWick / candleRange : 0.0
float lowerWickRatio = candleRange > 0 ? lowerWick / candleRange : 0.0
float candleATR      = atr14 > 0 ? candleRange / atr14 : 0.0

// Efficiency ratio (trend vs range)
float netMove20   = math.abs(close - close[20])
float totalPath20 = math.sum(math.abs(close - close[1]), 20)
float effRatio    = totalPath20 > 0 ? netMove20 / totalPath20 : 0.5

// ============================================================================
// CALCULATIONS — Regime
// ============================================================================

float bbWidthRaw  = bbUpper - bbLower
float bbWidthAvg  = ta.sma(bbWidthRaw, 50)
float bbWidthRatio = bbWidthAvg > 0 ? bbWidthRaw / bbWidthAvg : 1.0

bool isTrendUp   = ema20 > ema50 and effRatio > 0.35
bool isTrendDown = ema20 < ema50 and effRatio > 0.35
bool isRange     = effRatio <= 0.35
bool isHighVol   = bbWidthRatio > 1.3
bool isLowVol    = bbWidthRatio < 0.7

// ============================================================================
// CALCULATIONS — Swing Detection
// ============================================================================

float pivotHi = ta.pivothigh(high, leftBars, rightBars)
float pivotLo = ta.pivotlow(low, leftBars, rightBars)

var float lastSwingHigh = na
var float lastSwingLow  = na

if not na(pivotHi)
    lastSwingHigh := pivotHi
if not na(pivotLo)
    lastSwingLow := pivotLo

float majorPivotHi = ta.pivothigh(high, majLeftBars, majRightBars)
float majorPivotLo = ta.pivotlow(low, majLeftBars, majRightBars)

var float lastMajorHigh = na
var float lastMajorLow  = na

if not na(majorPivotHi)
    lastMajorHigh := majorPivotHi
if not na(majorPivotLo)
    lastMajorLow := majorPivotLo

// ============================================================================
// CALCULATIONS — Premium / Discount
// ============================================================================

// Premium / Discount zone
float pdRange        = not na(lastMajorHigh) and not na(lastMajorLow) ? lastMajorHigh - lastMajorLow : na
float pdPremiumLine  = not na(pdRange) and pdRange > 0 ? lastMajorLow + pdRange * 0.75 : na
float pdDiscountLine = not na(pdRange) and pdRange > 0 ? lastMajorLow + pdRange * 0.25 : na
int   priceZone      = not na(pdPremiumLine) and not na(pdDiscountLine) ? (close >= pdPremiumLine ? 1 : close <= pdDiscountLine ? -1 : 0) : 0

// ============================================================================
// CALCULATIONS — Structure Events
// ============================================================================

// Micro BOS
bool microBullBOS = not na(lastSwingHigh) and close > lastSwingHigh and close[1] <= lastSwingHigh
bool microBearBOS = not na(lastSwingLow)  and close < lastSwingLow  and close[1] >= lastSwingLow

// Major BOS
bool majorBullBOS = not na(lastMajorHigh) and close > lastMajorHigh and close[1] <= lastMajorHigh
bool majorBearBOS = not na(lastMajorLow)  and close < lastMajorLow  and close[1] >= lastMajorLow

// CHoCH tracking
var int microTrend = 0
var int majorTrend = 0

bool microBullCHoCH = microBullBOS and microTrend == -1
bool microBearCHoCH = microBearBOS and microTrend == 1
bool majorBullCHoCH = majorBullBOS and majorTrend == -1
bool majorBearCHoCH = majorBearBOS and majorTrend == 1

if microBullBOS
    microTrend := 1
if microBearBOS
    microTrend := -1
if majorBullBOS
    majorTrend := 1
if majorBearBOS
    majorTrend := -1

// Fake breaks / Springs / Upthrusts
bool fakeBreakout  = not na(lastSwingHigh) and high > lastSwingHigh and close <= lastSwingHigh
bool fakeBreakdown = not na(lastSwingLow)  and low < lastSwingLow   and close >= lastSwingLow
bool majFakeBreakout  = not na(lastMajorHigh) and high > lastMajorHigh and close <= lastMajorHigh
bool majFakeBreakdown = not na(lastMajorLow)  and low < lastMajorLow  and close >= lastMajorLow

bool isSpring         = fakeBreakdown and lowerWickRatio >= minWickRatio and candleATR >= minCandleATR
bool isUpthrust       = fakeBreakout  and upperWickRatio >= minWickRatio and candleATR >= minCandleATR
bool isMajorSpring    = majFakeBreakdown and lowerWickRatio >= minWickRatio and candleATR >= minCandleATR
bool isMajorUpthrust  = majFakeBreakout  and upperWickRatio >= minWickRatio and candleATR >= minCandleATR

// Climax detection — volume confirmation degrades to pass-through (range-only
// extreme bar) when volume is not real, so the climax sequence keeps working
// on price data alone.
bool isClimaxCandle   = candleATR >= climaxRangeATR and (volumeIsReal ? avgVol > 0 and volume >= climaxVolFact * avgVol : true)
bool isSellingClimax  = isClimaxCandle and close < open
bool isBuyingClimax   = isClimaxCandle and close > open

// Climax sequence state machine
var int   clxState     = 0
var int   clxDirection = 0
var float clxClose     = na
var float clxHigh      = na
var float clxLow       = na
var float clxRange     = na
var float clxVolume    = na
var int   clxBar       = na

if isClimaxCandle
    clxState     := 1
    clxDirection := isSellingClimax ? 1 : isBuyingClimax ? -1 : 0
    clxClose     := close
    clxHigh      := high
    clxLow       := low
    clxRange     := candleRange
    clxVolume    := volume
    clxBar       := bar_index

int  clxLookback   = 20
bool hasActiveClx  = clxState >= 1 and not na(clxBar) and (bar_index - clxBar) <= clxLookback

// One state step per bar at most (else-if chain), so a single bar cannot run 1→5
if hasActiveClx
    if clxState == 1
        if clxDirection == 1 and close > clxClose
            clxState := 2
        if clxDirection == -1 and close < clxClose
            clxState := 2
    else if clxState == 2
        bool clxReturning = false
        if clxDirection == 1 and not na(clxClose) and atr14 > 0
            clxReturning := close < clxClose + 1.5 * atr14 and close > clxLow - 0.5 * atr14
        if clxDirection == -1 and not na(clxClose) and atr14 > 0
            clxReturning := close > clxClose - 1.5 * atr14 and close < clxHigh + 0.5 * atr14
        if clxReturning and (bar_index - clxBar) >= 2
            clxState := 3
    else if clxState == 3
        bool clxTestBar_  = not na(clxRange) and candleRange <= clxRange * 0.6 and candleRange > 0 and (volumeIsReal ? not na(clxVolume) and volume <= clxVolume * 0.7 : true)
        bool clxInZone    = not na(clxClose) and atr14 > 0 and math.abs(close - clxClose) <= 1.5 * atr14
        if clxTestBar_ and clxInZone
            clxState := 4
    else if clxState == 4
        if clxDirection == 1 and (microBullBOS or majorBullBOS)
            clxState := 5
        if clxDirection == -1 and (microBearBOS or majorBearBOS)
            clxState := 5

// Expire the sequence after the lookback (hasActiveClx is already false here)
if clxState >= 1 and not na(clxBar) and (bar_index - clxBar) > clxLookback
    clxState := 0

bool clxConfirmed = clxState == 5
bool clxJustConfirmed = clxConfirmed and not clxConfirmed[1]

// ============================================================================
// LAST STRUCTURE EVENT
// ============================================================================

var string lastEventStr = "—"
var int    lastEventBar = na
var int    lastEventDir = 0

string evStr = ""
int    evDir = 0
if majorBullCHoCH
    evStr := "Major CHoCH ↑"
    evDir := 1
else if majorBearCHoCH
    evStr := "Major CHoCH ↓"
    evDir := -1
else if majorBullBOS
    evStr := "Major BOS ↑"
    evDir := 1
else if majorBearBOS
    evStr := "Major BOS ↓"
    evDir := -1
else if clxJustConfirmed and clxDirection == 1
    evStr := "CLX sequence ↑"
    evDir := 1
else if clxJustConfirmed and clxDirection == -1
    evStr := "CLX sequence ↓"
    evDir := -1
else if isMajorSpring
    evStr := "Major Spring"
    evDir := 1
else if isMajorUpthrust
    evStr := "Major Upthrust"
    evDir := -1
else if isSpring
    evStr := "Spring"
    evDir := 1
else if isUpthrust
    evStr := "Upthrust"
    evDir := -1
else if microBullCHoCH
    evStr := "CHoCH ↑"
    evDir := 1
else if microBearCHoCH
    evStr := "CHoCH ↓"
    evDir := -1
else if microBullBOS
    evStr := "BOS ↑"
    evDir := 1
else if microBearBOS
    evStr := "BOS ↓"
    evDir := -1

if evDir != 0
    lastEventStr := evStr
    lastEventBar := bar_index
    lastEventDir := evDir

// ============================================================================
// CANDLE STATE — Market condition heatmap
// ============================================================================
// Direction  → EMA alignment (ema20 vs ema50)
// Intensity  → Efficiency Ratio: how clean the move is
// Range      → Efficiency Ratio ≤ 0.35
// Conflict   → EMA direction opposite to the last major BOS direction
//
// Priority: Conflict → Range → Strong → Normal → Flat

bool emaBull = ema20 > ema50
bool emaBear = ema20 < ema50

bool isStateConflict = (emaBull and majorTrend == -1) or (emaBear and majorTrend == 1)
bool isStateRange    = isRange and not isStateConflict

bool isBullStrong = emaBull and not isRange and effRatio >= 0.5 and not isStateConflict
bool isBullNormal = emaBull and not isRange and effRatio < 0.5  and not isStateConflict
bool isBearStrong = emaBear and not isRange and effRatio >= 0.5 and not isStateConflict
bool isBearNormal = emaBear and not isRange and effRatio < 0.5  and not isStateConflict

// 1 conflict · 2 range · 3 up strong · 4 up · 5 down strong · 6 down · 0 flat
int stateCode = isStateConflict ? 1 : isStateRange ? 2 : isBullStrong ? 3 : isBullNormal ? 4 : isBearStrong ? 5 : isBearNormal ? 6 : 0

string candleState = stateCode == 1 ? "CONFLICT" : stateCode == 2 ? "RANGE" : stateCode == 3 ? "UP STRONG" : stateCode == 4 ? "UP" : stateCode == 5 ? "DOWN STRONG" : stateCode == 6 ? "DOWN" : "FLAT"

color cBullStrong = color.new(#1b5e20, 0)    // deep green
color cBullNormal = color.new(#2e7d32, 0)    // green
color cBearStrong = color.new(#7f0000, 0)    // deep red
color cBearNormal = color.new(#b71c1c, 0)    // red
color cConflict   = color.new(#e65100, 30)   // burnt orange
color cRangeState = color.new(#9e8a00, 55)   // sand / dull yellow
color cFlat       = color.new(#9e9e9e, 65)   // gray

color stateColor = stateCode == 1 ? cConflict : stateCode == 2 ? cRangeState : stateCode == 3 ? cBullStrong : stateCode == 4 ? cBullNormal : stateCode == 5 ? cBearStrong : stateCode == 6 ? cBearNormal : cFlat

// ============================================================================
// CANDLE COLORING
// ============================================================================

barcolor(showCandleColors ? stateColor : na)

// ============================================================================
// STRUCTURE EVENT MARKERS
// ============================================================================

plotshape(showEvents and majorBullCHoCH, "Major CHoCH Bull", shape.labelup, location.belowbar, color.new(bullColor, 20), text="CHoCH", textcolor=color.white, size=size.small)
plotshape(showEvents and majorBearCHoCH, "Major CHoCH Bear", shape.labeldown, location.abovebar, color.new(bearColor, 20), text="CHoCH", textcolor=color.white, size=size.small)
plotshape(showEvents and majorBullBOS and not majorBullCHoCH, "Major BOS Bull", shape.labelup, location.belowbar, color.new(bullColor, 50), text="BOS", textcolor=color.white, size=size.small)
plotshape(showEvents and majorBearBOS and not majorBearCHoCH, "Major BOS Bear", shape.labeldown, location.abovebar, color.new(bearColor, 50), text="BOS", textcolor=color.white, size=size.small)
plotshape(showEvents and (isSpring or isMajorSpring), "Spring", shape.triangleup, location.belowbar, color.new(bullColor, isMajorSpring ? 0 : 50), text="SPR", textcolor=bullColor, size=size.small)
plotshape(showEvents and (isUpthrust or isMajorUpthrust), "Upthrust", shape.triangledown, location.abovebar, color.new(bearColor, isMajorUpthrust ? 0 : 50), text="UT", textcolor=bearColor, size=size.small)
plotshape(showEvents and clxJustConfirmed and clxDirection == 1, "CLX Sequence Bull", shape.diamond, location.belowbar, color.new(#e040fb, 10), text="CLX", textcolor=#e040fb, size=size.small)
plotshape(showEvents and clxJustConfirmed and clxDirection == -1, "CLX Sequence Bear", shape.diamond, location.abovebar, color.new(#e040fb, 10), text="CLX", textcolor=#e040fb, size=size.small)

// ============================================================================
// STATE TABLE
// ============================================================================

color tc = color.new(color.gray, 20)   // standard text color (dark gray)
color hd = color.new(color.gray, 90)   // header row background (very light gray)

f_dirStr(int d) =>
    d == 1 ? "bull" : d == -1 ? "bear" : "—"

f_dirCol(int d) =>
    d == 1 ? #00c853 : d == -1 ? #d50000 : color.new(color.gray, 20)

var table t = table.new(tablePos, 3, 10,
     bgcolor=color.new(color.white, 5),
     border_color=color.new(color.gray, 60),
     border_width=1,
     frame_color=color.new(color.gray, 40),
     frame_width=1)

if showTable and barstate.islast
    string regimeStr = isTrendUp ? "TREND ↑" : isTrendDown ? "TREND ↓" : "RANGE"
    string volStr    = isHighVol ? "HIGH VOL" : isLowVol ? "LOW VOL" : "NORMAL"
    color  stateTableCol = stateCode == 1 ? color.new(#e65100, 20) : stateCode == 2 ? color.new(#9e8a00, 40) : stateCode == 3 ? color.new(#1b5e20, 10) : stateCode == 4 ? color.new(#2e7d32, 20) : stateCode == 5 ? color.new(#7f0000, 10) : stateCode == 6 ? color.new(#b71c1c, 20) : color.new(color.gray, 80)
    color  stateTextCol  = stateCode != 0 ? color.white : tc
    float  emaGapATR     = atr14 > 0 ? (ema20 - ema50) / atr14 : na
    string zoneStr  = priceZone == 1 ? "Premium" : priceZone == -1 ? "Discount" : not na(pdRange) and pdRange > 0 ? "Equilibrium" : "—"
    float  zonePos  = not na(pdRange) and pdRange > 0 ? (close - lastMajorLow) / pdRange * 100 : na
    string clxStr   = clxState == 0 ? "—" : clxState == 1 ? "CLX" : clxState == 2 ? "REACTING" : clxState == 3 ? "TEST PENDING" : clxState == 4 ? "TEST VALID" : "COMPLETE"

    // Header
    table.cell(t, 0, 0, "Vein Trend", text_color=tc, text_size=size.small, bgcolor=hd)
    table.cell(t, 1, 0, "",           text_color=tc, text_size=size.small, bgcolor=hd)
    table.cell(t, 2, 0, "v0.3",       text_color=tc, text_size=size.small, bgcolor=hd)

    // Candle state
    table.cell(t, 0, 1, "State",     text_color=tc, text_size=size.small)
    table.cell(t, 1, 1, candleState, text_color=stateTextCol, bgcolor=stateTableCol, text_size=size.small)
    table.cell(t, 2, 1, "",          text_color=stateTextCol, bgcolor=stateTableCol, text_size=size.small)

    // EMA
    table.cell(t, 0, 2, "EMA 20/50", text_color=tc, text_size=size.small)
    table.cell(t, 1, 2, emaBull ? "20 > 50" : emaBear ? "20 < 50" : "equal", text_color=emaBull ? #00c853 : emaBear ? #d50000 : tc, text_size=size.small)
    table.cell(t, 2, 2, na(emaGapATR) ? "—" : str.tostring(emaGapATR, "#.00") + " ATR", text_color=tc, text_size=size.small)

    // Efficiency / regime
    table.cell(t, 0, 3, "Efficiency", text_color=tc, text_size=size.small)
    table.cell(t, 1, 3, str.tostring(effRatio, "#.00"), text_color=tc, text_size=size.small)
    table.cell(t, 2, 3, regimeStr, text_color=tc, text_size=size.small)

    // Volatility
    table.cell(t, 0, 4, "BB width", text_color=tc, text_size=size.small)
    table.cell(t, 1, 4, str.tostring(bbWidthRatio, "#.00") + "×", text_color=tc, text_size=size.small)
    table.cell(t, 2, 4, volStr, text_color=tc, text_size=size.small)

    // Structure
    table.cell(t, 0, 5, "Structure", text_color=tc, text_size=size.small)
    table.cell(t, 1, 5, "micro " + f_dirStr(microTrend), text_color=f_dirCol(microTrend), text_size=size.small)
    table.cell(t, 2, 5, "major " + f_dirStr(majorTrend), text_color=f_dirCol(majorTrend), text_size=size.small)

    // Last structure event
    table.cell(t, 0, 6, "Last event", text_color=tc, text_size=size.small)
    table.cell(t, 1, 6, lastEventStr, text_color=f_dirCol(lastEventDir), text_size=size.small)
    table.cell(t, 2, 6, na(lastEventBar) ? "" : str.tostring(bar_index - lastEventBar) + " bars ago", text_color=tc, text_size=size.small)

    // Premium / discount
    table.cell(t, 0, 7, "Swing range", text_color=tc, text_size=size.small)
    table.cell(t, 1, 7, zoneStr, text_color=tc, text_size=size.small)
    table.cell(t, 2, 7, na(zonePos) ? "—" : str.tostring(zonePos, "#") + " %", text_color=tc, text_size=size.small)

    // Climax sequence
    table.cell(t, 0, 8, "Climax seq.", text_color=tc, text_size=size.small)
    table.cell(t, 1, 8, clxStr, text_color=tc, text_size=size.small)
    table.cell(t, 2, 8, clxState == 0 ? "" : f_dirStr(clxDirection), text_color=f_dirCol(clxState == 0 ? 0 : clxDirection), text_size=size.small)

    // Volume validity — climax volume check degrades to range-only when not real
    string volValidStr = volumeIsReal ? "real" : syminfo.volumetype + " — degraded"
    color  volValidBg  = volumeIsReal ? color.new(color.gray, 80) : color.new(#ff6f00, 70)
    color  volValidTc  = volumeIsReal ? tc : color.white
    table.cell(t, 0, 9, "Volume",    text_color=tc, text_size=size.small)
    table.cell(t, 1, 9, volValidStr, text_color=volValidTc, bgcolor=volValidBg, text_size=size.small)
    table.cell(t, 2, 9, "",          text_color=volValidTc, bgcolor=volValidBg, text_size=size.small)

// ============================================================================
// DATA WINDOW
// ============================================================================

plot(stateCode, "Candle State (1=conflict 2=range 3/4=up 5/6=down 0=flat)", display=display.data_window, color=color.new(color.gray, 100))
plot(effRatio, "Efficiency Ratio", display=display.data_window, color=color.new(color.gray, 100))
plot(microTrend, "Micro Structure (1=bull,-1=bear)", display=display.data_window, color=color.new(color.gray, 100))
plot(majorTrend, "Major Structure (1=bull,-1=bear)", display=display.data_window, color=color.new(color.gray, 100))
plot(clxState, "CLX State (0-5)", display=display.data_window, color=color.new(color.gray, 100))

// ============================================================================
// ALERTS — events
// ============================================================================

bool alertsOnBarClose = input.bool(true, "Alerts only on bar close (confirmed)", group="Alerts")
bool alertOk = not alertsOnBarClose or barstate.isconfirmed

bool stateChanged = stateCode != stateCode[1]

alertcondition(alertOk and stateChanged, "Vein Trend: Candle State Changed", "VEIN-TR · CANDLE STATE CHANGED · {{ticker}} {{interval}}")
alertcondition(alertOk and majorBullBOS and not majorBullCHoCH, "Vein Trend: Major BOS Bull", "VEIN-TR · MAJOR BOS BULL (close above major swing high) · {{ticker}} {{interval}}")
alertcondition(alertOk and majorBearBOS and not majorBearCHoCH, "Vein Trend: Major BOS Bear", "VEIN-TR · MAJOR BOS BEAR (close below major swing low) · {{ticker}} {{interval}}")
alertcondition(alertOk and majorBullCHoCH, "Vein Trend: Major CHoCH Bull", "VEIN-TR · MAJOR CHoCH BULL · {{ticker}} {{interval}}")
alertcondition(alertOk and majorBearCHoCH, "Vein Trend: Major CHoCH Bear", "VEIN-TR · MAJOR CHoCH BEAR · {{ticker}} {{interval}}")
