//@version=6
// ============================================================================
// Commodity Pulse Matrix v3 [WavesUnchained]
// Version: 3.7.0
// Author: WavesUnchained
// Build: 2026-11-17
// ============================================================================
// Multi-Timeframe Confluence Indicator for Commodities
//
// Features:
//   ✓ 6-Category Multi-Timeframe Scoring (Flow, Momentum, Trend, Volatility, Structure, Divergence)
//   ✓ Heat Score (multi-timeframe agreement display, 0-1)
//   ✓ Exhaustion Detection
//   ✓ MV Confluence (Momentum-Volume)
//   ✓ Diamond Zones (Support/Resistance)
//   ✓ Entry Engine V2 (breakout, pullback, continuation; trend + momentum in direction)
//   ✓ Market Regime Detection (BOS, CHoCH)
//   ✓ Matrix Table Visualization
//   ✓ Mean Reversion System
//
// Data Contract:
//   Price:     REQUIRED   chart symbol
//   Volume:    OPTIONAL   real trade volume only (MFI flow category, HTF
//              midline VWAP, MV Confluence) — degrades to neutral on tick/n/a volume
//   OI:        NO
//   Reference: NO
//   Verdict:   CFD-degraded
// ============================================================================

indicator("Commodity Pulse Matrix v3 [WavesUnchained]",
         shorttitle="CPM v3",
         overlay=true,
         max_labels_count=500,
         max_lines_count=500,
         max_boxes_count=500)

// ============================================================================
// MODULE IMPORTS (inline build will combine these)
