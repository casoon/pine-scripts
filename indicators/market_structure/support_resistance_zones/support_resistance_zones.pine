weightPivot = input.float(18, "Pivot Cluster", minval = 0, maxval = 50, group = groupScore)
weightTests = input.float(14, "Multiple Tests", minval = 0, maxval = 50, group = groupScore)
weightBase = input.float(12, "Base", minval = 0, maxval = 50, group = groupScore)
weightSD = input.float(18, "Supply / Demand", minval = 0, maxval = 50, group = groupScore)
weightOB = input.float(18, "Order Block", minval = 0, maxval = 50, group = groupScore)
weightFVG = input.float(10, "Fair Value Gap", minval = 0, maxval = 50, group = groupScore)
weightGap = input.float(8, "Price Gap", minval = 0, maxval = 50, group = groupScore)
weightLiquidity = input.float(12, "Liquidity", minval = 0, maxval = 50, group = groupScore)
weightBreakout = input.float(14, "Breakout / Flip", minval = 0, maxval = 50, group = groupScore)
weightEMA = input.float(5, "EMA Confluence", minval = 0, maxval = 30, group = groupScore)
weightVWAP = input.float(6, "VWAP Confluence", minval = 0, maxval = 30, group = groupScore)
weightFib = input.float(5, "Fibonacci Confluence", minval = 0, maxval = 30, group = groupScore)
weightPsych = input.float(3, "Psychological Level", minval = 0, maxval = 30, group = groupScore)
weightVolume = input.float(6, "Volume Confluence", minval = 0, maxval = 30, group = groupScore)

// ============================================================================
