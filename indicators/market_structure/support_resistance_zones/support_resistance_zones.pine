pivotClusterToleranceAtr = input.float(0.35, "Cluster Tolerance · ATR", minval = 0.05, maxval = 3, step = 0.05, group = groupPivot)
pivotPaddingAtr = input.float(0.08, "Zone Padding · ATR", minval = 0, maxval = 1, step = 0.01, group = groupPivot)
