lookbackBars = input.int(
     1200, "Maximum Analysis Lookback", minval = 100, maxval = 5000, group = groupGeneral,
     tooltip = "Maximum historical distance considered relevant for active zones. This does not mean every historical zone is drawn.")
maxStoredZones = input.int(
     180, "Maximum Stored Zones", minval = 20, maxval = 400, group = groupGeneral)
maxZonesPerSide = input.int(
     5, "Maximum Visible Zones Per Side", minval = 1, maxval = 20, group = groupGeneral,
     tooltip = "Maximum number of Support and Resistance zones rendered around price.")
minZoneScore = input.float(
     20.0, "Minimum Visible Zone Score", minval = 0, maxval = 100, step = 1, group = groupGeneral)
atrLength = input.int(
     14, "ATR Length", minval = 2, maxval = 200, group = groupGeneral)
maxZoneWidthAtr = input.float(
     2.0, "Maximum New Zone Width · ATR", minval = 0.1, maxval = 10, step = 0.1, group = groupGeneral)
maxMergedWidthAtr = input.float(
     3.0, "Maximum Merged Zone Width · ATR", minval = 0.25, maxval = 15, step = 0.1, group = groupGeneral)
mergeDistanceAtr = input.float(
     0.20, "Zone Merge Distance · ATR", minval = 0, maxval = 3, step = 0.05, group = groupGeneral,
     tooltip = "Zones of the same direction are merged when they overlap or are this close.")

