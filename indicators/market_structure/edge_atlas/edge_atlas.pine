// ============================================================================
// Preset resolution
// ============================================================================

bool presetClean      = presetInput == "Clean"
bool presetIntraday   = presetInput == "Intraday"
bool presetStructure  = presetInput == "Structure"
bool presetEverything = presetInput == "Everything"
bool presetCustom     = presetInput == "Custom"

bool useDayLevels   = presetCustom ? periodModuleInput : true
bool useWeekLevels  = presetCustom ? weekModuleInput : true
bool useMonthLevels = presetCustom ? monthModuleInput : presetEverything
bool useSessions    = presetCustom ? sessionsModuleInput : (presetIntraday or presetEverything)
bool usePivots      = presetCustom ? pivotModuleInput : (presetIntraday or presetEverything)
bool useFib         = presetCustom ? fibModuleInput : (presetStructure or presetEverything)
bool useSR          = presetCustom ? srModuleInput : (presetClean or presetIntraday or presetStructure or presetEverything)
bool useRound       = presetCustom ? roundModuleInput : presetEverything

// ============================================================================
// Types and registries
// ============================================================================

type Level
    float price
    float upper
    float lower
    string code
    string fullName
    string category
    int priority
    color levelColor
    bool isZone
    int touches

var array<Level> levels = array.new<Level>()
var array<line> renderedLines = array.new<line>()
var array<label> renderedLabels = array.new<label>()
var array<box> renderedBoxes = array.new<box>()

f_clearDrawings() =>
    for ln in renderedLines
        line.delete(ln)
    for lb in renderedLabels
        label.delete(lb)
    for bx in renderedBoxes
        box.delete(bx)
    array.clear(renderedLines)
    array.clear(renderedLabels)
    array.clear(renderedBoxes)

f_addLevel(
     float price,
     float upper,
     float lower,
     string code,
     string fullName,
     string category,
     int priority,
     color levelColor,
     bool isZone,
     int touches,
     bool enabled
 ) =>
    if enabled and not na(price)
        array.push(
             levels,
             Level.new(
                 price,
                 na(upper) ? price : upper,
                 na(lower) ? price : lower,
                 code,
                 fullName,
                 category,
                 priority,
                 levelColor,
                 isZone,
                 touches
             )
        )

f_labelSize() =>
    labelSizeInput == "Tiny" ? size.tiny :
     labelSizeInput == "Normal" ? size.normal : size.small

f_text(Level level) =>
    string base = labelContentInput == "Full name" ? level.fullName : level.code
    string withTouches = level.isZone and level.touches > 0 ? base + "  ×" + str.tostring(level.touches) : base
    showCategoryInput ? level.category + " · " + withTouches : withTouches

f_autoRoundStep(float price) =>
    float safePrice = math.max(math.abs(price), syminfo.mintick)
    float exponent = math.floor(math.log10(safePrice))
    float magnitude = math.pow(10.0, exponent)
    float normalized = safePrice / magnitude
    float factor = normalized < 2.0 ? 0.02 : normalized < 5.0 ? 0.05 : 0.10
    math.max(magnitude * factor, syminfo.mintick)

// JMA-style adaptive smoothing — an open-source, Jurik-inspired approximation,
// not Mark Jurik's patented, proprietary original algorithm. Same formula used
// elsewhere in this repo (jma_struct.pine, candle_pressure_response_jma.pine).
f_jma(float src, int length, float phase, float power) =>
    float phaseRatio = phase < -100 ? 0.5 : phase > 100 ? 2.5 : phase / 100 + 1.5
    float beta = 0.45 * (length - 1) / (0.45 * (length - 1) + 2)
    float alpha = math.pow(beta, power)

    var float e0 = na
    var float e1 = na
    var float e2 = na
    var float jma = na

    e0 := (1 - alpha) * src + alpha * nz(e0[1], src)
    e1 := (src - e0) * (1 - beta) + beta * nz(e1[1], 0)
    e2 := (e0 + phaseRatio * e1 - nz(jma[1], src)) * math.pow(1 - alpha, 2) + math.pow(alpha, 2) * nz(e2[1], 0)
    jma := e2 + nz(jma[1], src)
    jma

f_maValue(string maType, float src, int length, float phase, float power) =>
    switch maType
        "JMA-style" => f_jma(src, length, phase, power)
        "EMA" => ta.ema(src, length)
        => ta.sma(src, length)

// ============================================================================
// Core series
// ============================================================================

float atr = ta.atr(14)
float safeAtr = math.max(nz(atr, syminfo.mintick), syminfo.mintick)

// Duration of one bar in ms — the only per-bar timing metric the render block
// still needs now that label/rail positioning no longer reads the viewport.
int atlasBarMs = int(math.max(nz(time - time[1], timeframe.in_seconds() * 1000.0), 1.0))

float pdh = request.security(syminfo.tickerid, "D", high[1], lookahead = barmerge.lookahead_on)
float pdl = request.security(syminfo.tickerid, "D", low[1], lookahead = barmerge.lookahead_on)
float pdo = request.security(syminfo.tickerid, "D", open[1], lookahead = barmerge.lookahead_on)
float pdc = request.security(syminfo.tickerid, "D", close[1], lookahead = barmerge.lookahead_on)
float dayOpen = request.security(syminfo.tickerid, "D", open, lookahead = barmerge.lookahead_on)

float pwh = request.security(syminfo.tickerid, "W", high[1], lookahead = barmerge.lookahead_on)
float pwl = request.security(syminfo.tickerid, "W", low[1], lookahead = barmerge.lookahead_on)
float pwo = request.security(syminfo.tickerid, "W", open[1], lookahead = barmerge.lookahead_on)
float pwc = request.security(syminfo.tickerid, "W", close[1], lookahead = barmerge.lookahead_on)
float weekOpen = request.security(syminfo.tickerid, "W", open, lookahead = barmerge.lookahead_on)

float pmh = request.security(syminfo.tickerid, "M", high[1], lookahead = barmerge.lookahead_on)
float pml = request.security(syminfo.tickerid, "M", low[1], lookahead = barmerge.lookahead_on)
float pmo = request.security(syminfo.tickerid, "M", open[1], lookahead = barmerge.lookahead_on)
float pmc = request.security(syminfo.tickerid, "M", close[1], lookahead = barmerge.lookahead_on)
float monthOpen = request.security(syminfo.tickerid, "M", open, lookahead = barmerge.lookahead_on)

// ============================================================================
// Session tracking
// ============================================================================

bool inAsia = not na(time(timeframe.period, asiaSessionInput, sessionTimezoneInput))
bool asiaStart = inAsia and not inAsia[1]
bool asiaEnd = not inAsia and inAsia[1]
var float asiaDevHigh = na
var float asiaDevLow = na
var float asiaDoneHigh = na
var float asiaDoneLow = na
if asiaStart
    asiaDevHigh := high
    asiaDevLow := low
else if inAsia
    asiaDevHigh := math.max(nz(asiaDevHigh, high), high)
    asiaDevLow := math.min(nz(asiaDevLow, low), low)
if asiaEnd
    asiaDoneHigh := asiaDevHigh
    asiaDoneLow := asiaDevLow

bool inLondon = not na(time(timeframe.period, londonSessionInput, sessionTimezoneInput))
bool londonStart = inLondon and not inLondon[1]
bool londonEnd = not inLondon and inLondon[1]
var float londonDevHigh = na
var float londonDevLow = na
var float londonDoneHigh = na
var float londonDoneLow = na
if londonStart
    londonDevHigh := high
    londonDevLow := low
else if inLondon
    londonDevHigh := math.max(nz(londonDevHigh, high), high)
    londonDevLow := math.min(nz(londonDevLow, low), low)
if londonEnd
    londonDoneHigh := londonDevHigh
    londonDoneLow := londonDevLow

bool inNY = not na(time(timeframe.period, nySessionInput, sessionTimezoneInput))
bool nyStart = inNY and not inNY[1]
bool nyEnd = not inNY and inNY[1]
var float nyDevHigh = na
var float nyDevLow = na
var float nyDoneHigh = na
var float nyDoneLow = na
if nyStart
    nyDevHigh := high
    nyDevLow := low
else if inNY
    nyDevHigh := math.max(nz(nyDevHigh, high), high)
    nyDevLow := math.min(nz(nyDevLow, low), low)
if nyEnd
    nyDoneHigh := nyDevHigh
    nyDoneLow := nyDevLow

float asiaHigh = useCompletedSessionInput ? asiaDoneHigh : (inAsia ? asiaDevHigh : asiaDoneHigh)
float asiaLow = useCompletedSessionInput ? asiaDoneLow : (inAsia ? asiaDevLow : asiaDoneLow)
float londonHigh = useCompletedSessionInput ? londonDoneHigh : (inLondon ? londonDevHigh : londonDoneHigh)
float londonLow = useCompletedSessionInput ? londonDoneLow : (inLondon ? londonDevLow : londonDoneLow)
float nyHigh = useCompletedSessionInput ? nyDoneHigh : (inNY ? nyDevHigh : nyDoneHigh)
float nyLow = useCompletedSessionInput ? nyDoneLow : (inNY ? nyDevLow : nyDoneLow)

// ============================================================================
// Pivot points
// ============================================================================

string pivotTf = pivotPeriodInput == "Weekly" ? "W" : pivotPeriodInput == "Monthly" ? "M" : "D"
float pivotHigh = request.security(syminfo.tickerid, pivotTf, high[1], lookahead = barmerge.lookahead_on)
float pivotLow = request.security(syminfo.tickerid, pivotTf, low[1], lookahead = barmerge.lookahead_on)
float pivotClose = request.security(syminfo.tickerid, pivotTf, close[1], lookahead = barmerge.lookahead_on)
float pp = (pivotHigh + pivotLow + pivotClose) / 3.0
float pivotRange = pivotHigh - pivotLow

float r1 = pivotMethodInput == "Fibonacci" ? pp + 0.382 * pivotRange : 2.0 * pp - pivotLow
float s1 = pivotMethodInput == "Fibonacci" ? pp - 0.382 * pivotRange : 2.0 * pp - pivotHigh
float r2 = pivotMethodInput == "Fibonacci" ? pp + 0.618 * pivotRange : pp + pivotRange
float s2 = pivotMethodInput == "Fibonacci" ? pp - 0.618 * pivotRange : pp - pivotRange
float r3 = pivotMethodInput == "Fibonacci" ? pp + 1.000 * pivotRange : pivotHigh + 2.0 * (pp - pivotLow)
float s3 = pivotMethodInput == "Fibonacci" ? pp - 1.000 * pivotRange : pivotLow - 2.0 * (pivotHigh - pp)

// ============================================================================
// Swing Fibonacci tracking
// ============================================================================

float fibPH = ta.pivothigh(high, fibPivotLeftInput, fibPivotRightInput)
float fibPL = ta.pivotlow(low, fibPivotLeftInput, fibPivotRightInput)

var float lastFibHigh = na
var float lastFibLow = na
var int lastFibHighBar = na
var int lastFibLowBar = na

if not na(fibPH)
    lastFibHigh := fibPH
    lastFibHighBar := bar_index - fibPivotRightInput
if not na(fibPL)
    lastFibLow := fibPL
    lastFibLowBar := bar_index - fibPivotRightInput

bool fibBullLeg = not na(lastFibHighBar) and not na(lastFibLowBar) and lastFibLowBar < lastFibHighBar
bool fibBearLeg = not na(lastFibHighBar) and not na(lastFibLowBar) and lastFibHighBar < lastFibLowBar
float fibLegSize = math.abs(lastFibHigh - lastFibLow)
bool validFibLeg = fibLegSize >= fibMinLegAtrInput * safeAtr

f_fibPrice(float ratio) =>
    fibBullLeg ? lastFibHigh - fibLegSize * ratio :
     fibBearLeg ? lastFibLow + fibLegSize * ratio : na

f_extensionPrice(float ratio) =>
    fibBullLeg ? lastFibLow + fibLegSize * ratio :
     fibBearLeg ? lastFibHigh - fibLegSize * ratio : na

// ============================================================================
// Pivot-cluster S/R
// ============================================================================

var array<float> supportCenters = array.new_float()
var array<int> supportTouches = array.new_int()
var array<int> supportLastBars = array.new_int()

var array<float> resistanceCenters = array.new_float()
var array<int> resistanceTouches = array.new_int()
var array<int> resistanceLastBars = array.new_int()

f_updateCluster(
     array<float> centers,
     array<int> touches,
     array<int> lastBars,
     float pivotPrice,
     int pivotBar,
     float tolerance
 ) =>
    int bestIndex = -1
    float bestDistance = 1e100
    if array.size(centers) > 0
        for i = 0 to array.size(centers) - 1
            float distance = math.abs(array.get(centers, i) - pivotPrice)
            if distance <= tolerance and distance < bestDistance
                bestDistance := distance
                bestIndex := i
    if bestIndex >= 0
        int oldTouches = array.get(touches, bestIndex)
        float oldCenter = array.get(centers, bestIndex)
        float newCenter = (oldCenter * oldTouches + pivotPrice) / (oldTouches + 1)
        array.set(centers, bestIndex, newCenter)
        array.set(touches, bestIndex, oldTouches + 1)
        array.set(lastBars, bestIndex, pivotBar)
    else
        array.push(centers, pivotPrice)
        array.push(touches, 1)
        array.push(lastBars, pivotBar)

float srPH = ta.pivothigh(high, srPivotLeftInput, srPivotRightInput)
float srPL = ta.pivotlow(low, srPivotLeftInput, srPivotRightInput)

if not na(srPH)
    f_updateCluster(
         resistanceCenters,
         resistanceTouches,
         resistanceLastBars,
         srPH,
         bar_index - srPivotRightInput,
         srClusterAtrInput * safeAtr
    )

if not na(srPL)
    f_updateCluster(
         supportCenters,
         supportTouches,
         supportLastBars,
         srPL,
         bar_index - srPivotRightInput,
         srClusterAtrInput * safeAtr
    )

// Prevent unlimited historical growth.
int MAX_CLUSTERS = 80
while array.size(supportCenters) > MAX_CLUSTERS
    array.shift(supportCenters)
    array.shift(supportTouches)
    array.shift(supportLastBars)
while array.size(resistanceCenters) > MAX_CLUSTERS
    array.shift(resistanceCenters)
    array.shift(resistanceTouches)
    array.shift(resistanceLastBars)

// ============================================================================
// Build normalized level registry
// ============================================================================

array.clear(levels)

color dayColor = color.rgb(68, 138, 255)
color weekColor = color.rgb(139, 92, 246)
color monthColor = color.rgb(236, 72, 153)
color sessionColor = color.rgb(14, 165, 233)
color pivotColor = color.rgb(245, 158, 11)
color fibColor = color.rgb(34, 197, 94)
color resistanceColor = color.rgb(239, 68, 68)
color supportColor = color.rgb(16, 185, 129)
color roundColor = color.rgb(148, 163, 184)

bool customOrEverything = presetCustom or presetEverything

// Day levels
f_addLevel(pdh, na, na, "PDH", "Previous Day High", "DAY", 9, dayColor, false, 0,
     useDayLevels and (presetCustom ? showPDHInput : true))
f_addLevel(pdl, na, na, "PDL", "Previous Day Low", "DAY", 9, dayColor, false, 0,
     useDayLevels and (presetCustom ? showPDLInput : true))
f_addLevel(pdc, na, na, "PDC", "Previous Day Close", "DAY", 7, dayColor, false, 0,
     useDayLevels and (presetCustom ? showPDCInput : true))
f_addLevel(pdo, na, na, "PDO", "Previous Day Open", "DAY", 5, dayColor, false, 0,
     useDayLevels and customOrEverything and showPDOInput)
f_addLevel(dayOpen, na, na, "DO", "Current Day Open", "DAY", 8, dayColor, false, 0,
     useDayLevels and (presetCustom ? showDOInput : true))
f_addLevel((pdh + pdl) / 2.0, na, na, "PDM", "Previous Day Midpoint", "DAY", 4, dayColor, false, 0,
     useDayLevels and customOrEverything and showPDMInput)

// Week levels
f_addLevel(pwh, na, na, "PWH", "Previous Week High", "WEEK", 9, weekColor, false, 0,
     useWeekLevels and (presetCustom ? showPWHInput : true))
f_addLevel(pwl, na, na, "PWL", "Previous Week Low", "WEEK", 9, weekColor, false, 0,
     useWeekLevels and (presetCustom ? showPWLInput : true))
f_addLevel(pwc, na, na, "PWC", "Previous Week Close", "WEEK", 6, weekColor, false, 0,
     useWeekLevels and customOrEverything and showPWCInput)
f_addLevel(pwo, na, na, "PWO", "Previous Week Open", "WEEK", 5, weekColor, false, 0,
     useWeekLevels and customOrEverything and showPWOInput)
f_addLevel(weekOpen, na, na, "WO", "Current Week Open", "WEEK", 8, weekColor, false, 0,
     useWeekLevels and (presetCustom ? showWOInput : true))
f_addLevel((pwh + pwl) / 2.0, na, na, "PWM", "Previous Week Midpoint", "WEEK", 4, weekColor, false, 0,
     useWeekLevels and customOrEverything and showPWMInput)

// Month levels
f_addLevel(pmh, na, na, "PMH", "Previous Month High", "MONTH", 8, monthColor, false, 0,
     useMonthLevels and (presetCustom ? showPMHInput : true))
f_addLevel(pml, na, na, "PML", "Previous Month Low", "MONTH", 8, monthColor, false, 0,
     useMonthLevels and (presetCustom ? showPMLInput : true))
f_addLevel(pmc, na, na, "PMC", "Previous Month Close", "MONTH", 5, monthColor, false, 0,
     useMonthLevels and (presetCustom ? showPMCInput : true))
f_addLevel(pmo, na, na, "PMO", "Previous Month Open", "MONTH", 5, monthColor, false, 0,
     useMonthLevels and (presetCustom ? showPMOInput : true))
f_addLevel(monthOpen, na, na, "MO", "Current Month Open", "MONTH", 7, monthColor, false, 0,
     useMonthLevels and (presetCustom ? showMOInput : true))
f_addLevel((pmh + pml) / 2.0, na, na, "PMM", "Previous Month Midpoint", "MONTH", 4, monthColor, false, 0,
     useMonthLevels and (presetCustom ? showPMMInput : true))

// Sessions
bool asiaActive = useSessions and (presetCustom ? asiaEnableInput : presetEverything)
bool londonActive = useSessions and (presetCustom ? londonEnableInput : presetIntraday or presetEverything)
bool nyActive = useSessions and (presetCustom ? nyEnableInput : presetIntraday or presetEverything)

f_addLevel(asiaHigh, na, na, "ASH", "Asia Session High", "SESSION", 7, sessionColor, false, 0,
     asiaActive and (presetCustom ? asiaHighInput : true))
f_addLevel(asiaLow, na, na, "ASL", "Asia Session Low", "SESSION", 7, sessionColor, false, 0,
     asiaActive and (presetCustom ? asiaLowInput : true))
f_addLevel((asiaHigh + asiaLow) / 2.0, na, na, "ASM", "Asia Session Midpoint", "SESSION", 4, sessionColor, false, 0,
     asiaActive and presetCustom and asiaMidInput)

f_addLevel(londonHigh, na, na, "LDH", "London Session High", "SESSION", 7, sessionColor, false, 0,
     londonActive and (presetCustom ? londonHighInput : true))
f_addLevel(londonLow, na, na, "LDL", "London Session Low", "SESSION", 7, sessionColor, false, 0,
     londonActive and (presetCustom ? londonLowInput : true))
f_addLevel((londonHigh + londonLow) / 2.0, na, na, "LDM", "London Session Midpoint", "SESSION", 4, sessionColor, false, 0,
     londonActive and presetCustom and londonMidInput)

f_addLevel(nyHigh, na, na, "NYH", "New York Session High", "SESSION", 7, sessionColor, false, 0,
     nyActive and (presetCustom ? nyHighInput : true))
f_addLevel(nyLow, na, na, "NYL", "New York Session Low", "SESSION", 7, sessionColor, false, 0,
     nyActive and (presetCustom ? nyLowInput : true))
f_addLevel((nyHigh + nyLow) / 2.0, na, na, "NYM", "New York Session Midpoint", "SESSION", 4, sessionColor, false, 0,
     nyActive and presetCustom and nyMidInput)

// Pivot points
f_addLevel(pp, na, na, "PP", "Central Pivot Point", "PIVOT", 8, pivotColor, false, 0,
     usePivots and (presetCustom ? showPPInput : true))
f_addLevel(r1, na, na, "R1", "Pivot Resistance 1", "PIVOT", 7, pivotColor, false, 0,
     usePivots and (presetCustom ? showR1Input : true))
f_addLevel(s1, na, na, "S1", "Pivot Support 1", "PIVOT", 7, pivotColor, false, 0,
     usePivots and (presetCustom ? showS1Input : true))
f_addLevel(r2, na, na, "R2", "Pivot Resistance 2", "PIVOT", 6, pivotColor, false, 0,
     usePivots and (presetCustom ? showR2Input : true))
f_addLevel(s2, na, na, "S2", "Pivot Support 2", "PIVOT", 6, pivotColor, false, 0,
     usePivots and (presetCustom ? showS2Input : true))
f_addLevel(r3, na, na, "R3", "Pivot Resistance 3", "PIVOT", 5, pivotColor, false, 0,
     usePivots and presetCustom and showR3Input)
f_addLevel(s3, na, na, "S3", "Pivot Support 3", "PIVOT", 5, pivotColor, false, 0,
     usePivots and presetCustom and showS3Input)

// Swing Fibonacci
bool fibActive = useFib and validFibLeg
f_addLevel(f_fibPrice(0.236), na, na, "F23.6", "Fibonacci 23.6%", "FIB", 5, fibColor, false, 0,
     fibActive and (presetCustom ? fib236Input : presetEverything))
f_addLevel(f_fibPrice(0.382), na, na, "F38.2", "Fibonacci 38.2%", "FIB", 7, fibColor, false, 0,
     fibActive and (presetCustom ? fib382Input : true))
f_addLevel(f_fibPrice(0.500), na, na, "F50.0", "Fibonacci 50.0%", "FIB", 7, fibColor, false, 0,
     fibActive and (presetCustom ? fib500Input : true))
f_addLevel(f_fibPrice(0.618), na, na, "F61.8", "Fibonacci 61.8%", "FIB", 8, fibColor, false, 0,
     fibActive and (presetCustom ? fib618Input : true))
f_addLevel(f_fibPrice(0.786), na, na, "F78.6", "Fibonacci 78.6%", "FIB", 5, fibColor, false, 0,
     fibActive and (presetCustom ? fib786Input : presetEverything))
f_addLevel(f_fibPrice(1.000), na, na, "F100", "Fibonacci 100.0%", "FIB", 5, fibColor, false, 0,
     fibActive and (presetCustom ? fib100Input : presetEverything))
f_addLevel(f_extensionPrice(1.272), na, na, "F127", "Fibonacci Extension 127.2%", "FIB", 5, fibColor, false, 0,
     fibActive and (presetCustom ? fib1272Input : presetEverything))
f_addLevel(f_extensionPrice(1.618), na, na, "F162", "Fibonacci Extension 161.8%", "FIB", 6, fibColor, false, 0,
     fibActive and (presetCustom ? fib1618Input : presetEverything))

// S/R candidates: collect eligible indices and sort by distance.
if useSR
    array<float> supportDistances = array.new_float()
    array<int> supportIndices = array.new_int()
    if array.size(supportCenters) > 0
        for i = 0 to array.size(supportCenters) - 1
            float center = array.get(supportCenters, i)
            int touches = array.get(supportTouches, i)
            int age = bar_index - array.get(supportLastBars, i)
            if center < close and touches >= srMinTouchesInput and age <= srMaxAgeInput
                array.push(supportDistances, close - center)
                array.push(supportIndices, i)
    array<int> supportOrder = array.sort_indices(supportDistances)
    int supportsToRender = math.min(srSupportsInput, array.size(supportOrder))
    if supportsToRender > 0
        for rank = 0 to supportsToRender - 1
            int distanceIndex = array.get(supportOrder, rank)
            int clusterIndex = array.get(supportIndices, distanceIndex)
            float center = array.get(supportCenters, clusterIndex)
            int touches = array.get(supportTouches, clusterIndex)
            float halfWidth = srZoneWidthAtrInput * safeAtr * 0.5
            f_addLevel(center, center + halfWidth, center - halfWidth, "S" + str.tostring(rank + 1),
                 "Support Zone " + str.tostring(rank + 1), "S/R", 8, supportColor, true, touches, true)

    array<float> resistanceDistances = array.new_float()
    array<int> resistanceIndices = array.new_int()
    if array.size(resistanceCenters) > 0
        for i = 0 to array.size(resistanceCenters) - 1
            float center = array.get(resistanceCenters, i)
            int touches = array.get(resistanceTouches, i)
            int age = bar_index - array.get(resistanceLastBars, i)
            if center > close and touches >= srMinTouchesInput and age <= srMaxAgeInput
                array.push(resistanceDistances, center - close)
                array.push(resistanceIndices, i)
    array<int> resistanceOrder = array.sort_indices(resistanceDistances)
    int resistancesToRender = math.min(srResistancesInput, array.size(resistanceOrder))
    if resistancesToRender > 0
        for rank = 0 to resistancesToRender - 1
            int distanceIndex = array.get(resistanceOrder, rank)
            int clusterIndex = array.get(resistanceIndices, distanceIndex)
            float center = array.get(resistanceCenters, clusterIndex)
            int touches = array.get(resistanceTouches, clusterIndex)
            float halfWidth = srZoneWidthAtrInput * safeAtr * 0.5
            f_addLevel(center, center + halfWidth, center - halfWidth, "R" + str.tostring(rank + 1),
                 "Resistance Zone " + str.tostring(rank + 1), "S/R", 8, resistanceColor, true, touches, true)

// Round numbers
if useRound
    float majorStep = roundAutoStepInput ? f_autoRoundStep(close) : roundManualStepInput
    float smallestStep = roundQuarterInput ? majorStep * 0.25 : roundHalfInput ? majorStep * 0.5 : majorStep
    int baseIndex = int(math.floor(close / smallestStep))
    for offset = -roundLevelsEachSideInput to roundLevelsEachSideInput
        if offset != 0
            float levelPrice = (baseIndex + offset) * smallestStep
            float normalizedMajor = levelPrice / majorStep
            float fraction = math.abs(normalizedMajor - math.round(normalizedMajor))
            bool isMajor = fraction < 0.000001
            bool isHalf = math.abs(fraction - 0.5) < 0.000001
            bool allowed = isMajor ? roundMajorInput : isHalf ? roundHalfInput : roundQuarterInput
            string code = isMajor ? "RN" : isHalf ? "RN½" : "RN¼"
            f_addLevel(levelPrice, na, na, code, "Round Number", "ROUND", isMajor ? 5 : 3,
                 roundColor, false, 0, allowed)

// ============================================================================
// Trend Curves — preset resolution
// ============================================================================
// Lengths are always in bars of the current chart timeframe, never auto-scaled
// by resolution — a "20" means 20 candles whether the chart is on 5m or 1D.

string fastTrendType = switch trendPresetInput
    "Custom"     => fastTypeInput
    "Structural" => "EMA"
    => "JMA-style"
int fastTrendLength = switch trendPresetInput
    "Custom"     => fastLengthInput
    "Responsive" => 9
    "Structural" => 20
    => 21
float fastTrendPhase = switch trendPresetInput
    "Custom" => fastPhaseInput
    => 0.0
float fastTrendPower = switch trendPresetInput
    "Custom" => fastPowerInput
    => 2.0

string baseTrendType = switch trendPresetInput
    "Custom"     => baseTypeInput
    "Responsive" => "JMA-style"
    "Balanced"   => "EMA"
    => "SMA"
int baseTrendLength = switch trendPresetInput
    "Custom"     => baseLengthInput
    "Responsive" => 21
    => 50
float baseTrendPhase = switch trendPresetInput
    "Custom" => basePhaseInput
    => 0.0
float baseTrendPower = switch trendPresetInput
    "Custom" => basePowerInput
    => 2.0

string anchorTrendType = switch trendPresetInput
    "Custom"     => anchorTypeInput
    "Responsive" => "JMA-style"
    => "SMA"
int anchorTrendLength = switch trendPresetInput
    "Custom"     => anchorLengthInput
    "Responsive" => 50
    => 200
float anchorTrendPhase = switch trendPresetInput
    "Custom" => anchorPhaseInput
    => 0.0
float anchorTrendPower = switch trendPresetInput
    "Custom" => anchorPowerInput
    => 2.0

float fastTrendValue = f_maValue(fastTrendType, trendSourceInput, fastTrendLength, fastTrendPhase, fastTrendPower)
float baseTrendValue = f_maValue(baseTrendType, trendSourceInput, baseTrendLength, baseTrendPhase, baseTrendPower)
float anchorTrendValue = f_maValue(anchorTrendType, trendSourceInput, anchorTrendLength, anchorTrendPhase, anchorTrendPower)

int trendLineWidth = switch trendEmphasisInput
    "Subtle" => 1
    "Bold" => 3
    => 2

color fastTrendColor = color.rgb(41, 98, 255)
color baseTrendColor = color.rgb(255, 152, 0)
color anchorTrendColor = color.rgb(120, 123, 134)

plot(trendModuleInput and showFastInput ? fastTrendValue : na, "Fast Curve",
     color = fastTrendColor, linewidth = trendLineWidth, offset = trendOffsetInput)
plot(trendModuleInput and showBaseInput ? baseTrendValue : na, "Base Curve",
     color = baseTrendColor, linewidth = trendLineWidth, offset = trendOffsetInput)
plot(trendModuleInput and showAnchorInput ? anchorTrendValue : na, "Anchor Curve",
     color = anchorTrendColor, linewidth = trendLineWidth, offset = trendOffsetInput)

// ============================================================================
// Render
// ============================================================================

if barstate.islast
    f_clearDrawings()

    if masterEnableInput
        // Label anchor is always a simple forward offset from the last real bar —
        // a fixed bar count, not a percentage of the visible time range. That
        // earlier version recomputed a different offset on every scroll/zoom, and
        // since Pine only redraws when the script recalculates (not continuously
        // during a drag), the label would freeze mid-pan and then jump to the new
        // position once a recalculation happened, instead of panning smoothly like
        // a normal drawing. A fixed bar count keeps the label at the same calendar
        // time regardless of scroll position, so redraws land exactly where the
        // label already was — nothing to jump. "time" itself only moves when new
        // data arrives, not on chart navigation, so the anchor is fully stable.
        // Deliberately NOT computed by subtracting from chart.right_visible_bar_time
        // either, which this script's own future-projected drawings can shift on
        // the next recalculation, making that a moving target too.
        //
        // The rail no longer tries to reach the chart's true right edge (dropped on
        // request — keeping the current price area uncluttered matters more than
        // the rail visually touching the price scale). It's a fixed-length segment
        // starting just past the label, extend.none instead of extend.right.
        int gapTime = labelOffsetBarsInput * atlasBarMs
        int labelAnchorTime = time + gapTime
        // Visual gap between the label and where the rail picks up.
        int labelToRailGap = int(math.max(gapTime * 0.03, atlasBarMs * 2.0))
        int railStartTime = labelAnchorTime + labelToRailGap
        int railSeedEnd = railStartTime + int(math.max(gapTime * 0.5, atlasBarMs * 5.0))
        // Hard ceiling on how far into the future ANY rail endpoint can land, well
        // under Pine's bounded future-drawing distance (roughly 500 bars). Without
        // this, a large "Label offset · bars" combined with a high "Maximum
        // rendered levels" (which pushes each rank further out via the stagger
        // below) could push the highest-ranked rails past that limit and get
        // silently clamped — recreating the shared-coordinate vertical-bar bug
        // this script has already hit twice, just via inputs instead of zoom.
        int futureLimitTime = time + atlasBarMs * 480

        // Build candidate distances and sort by priority first, then distance.
        array<float> sortKeys = array.new_float()
        array<int> candidateIndices = array.new_int()

        if array.size(levels) > 0
            for i = 0 to array.size(levels) - 1
                Level level = array.get(levels, i)
                float distanceAtr = math.abs(level.price - close) / safeAtr
                bool sideAllowed = level.price >= close ? showAboveInput : showBelowInput
                bool eligible = sideAllowed and distanceAtr <= maxDistanceAtrInput and level.priority >= minPriorityInput
                if eligible
                    // Lower key sorts first: priority dominates, distance breaks ties.
                    float key = (10 - level.priority) * 1000000.0 + distanceAtr
                    array.push(sortKeys, key)
                    array.push(candidateIndices, i)

        // ATR-based rather than visible-price-range-based: tied to the instrument's
        // own volatility, so which levels get culled doesn't change just because the
        // user scrolled or zoomed to a different price range.
        float minLabelSpacing = minLabelSpacingAtrInput * safeAtr

        array<int> order = array.sort_indices(sortKeys)

        // Greedily accept candidates in priority/distance order, skipping any level
        // that sits too close (relative to ATR) to an already-accepted level so the
        // right-edge stack does not collapse into overlapping label boxes.
        array<float> acceptedPrices = array.new_float()
        array<int> acceptedIndices = array.new_int()
        if array.size(order) > 0
            for rank = 0 to array.size(order) - 1
                int candidatePos = array.get(order, rank)
                int levelIndex = array.get(candidateIndices, candidatePos)
                Level candidate = array.get(levels, levelIndex)
                bool tooClose = false
                if minLabelSpacing > 0 and array.size(acceptedPrices) > 0
                    for j = 0 to array.size(acceptedPrices) - 1
                        if math.abs(array.get(acceptedPrices, j) - candidate.price) < minLabelSpacing
                            tooClose := true
                if not tooClose
                    array.push(acceptedPrices, candidate.price)
                    array.push(acceptedIndices, levelIndex)
                if array.size(acceptedIndices) >= maxLevelsInput
                    break

        int renderCount = array.size(acceptedIndices)

        if renderCount > 0
            for rank = 0 to renderCount - 1
                int levelIndex = array.get(acceptedIndices, rank)
                Level level = array.get(levels, levelIndex)

                color railColor = color.new(level.levelColor, lineTransparencyInput)
                color labelColor = color.new(level.levelColor, labelTransparencyInput)
                string labelText = f_text(level)

                // Every rail is staggered by rank so no two levels ever share the exact
                // same starting x-coordinate. Without this, several differently-colored
                // horizontal lines all beginning at the identical pixel column, stacked
                // closely in price, read as a vertical multi-colored bar at that column
                // regardless of how long each segment then runs — tuning the segment
                // length alone (tried repeatedly) only ever reduces the odds at whatever
                // zoom level happens to get tested, it doesn't remove the shared origin.
                int levelRailStart = math.min(railStartTime + rank * atlasBarMs, futureLimitTime - atlasBarMs)
                int levelRailEnd = math.min(railSeedEnd + rank * atlasBarMs, futureLimitTime)

                line rail = line.new(
                     levelRailStart,
                     level.price,
                     levelRailEnd,
                     level.price,
                     xloc = xloc.bar_time,
                     extend = extend.none,
                     color = railColor,
                     width = lineWidthInput
                )
                array.push(renderedLines, rail)

                label tag = label.new(
                     labelAnchorTime,
                     level.price,
                     labelText,
                     xloc = xloc.bar_time,
                     yloc = yloc.price,
                     style = label.style_label_right,
                     color = labelColor,
                     textcolor = color.white,
                     size = f_labelSize(),
                     tooltip =
                         level.code + " — " + level.fullName + "\n" +
                         "Price: " + str.tostring(level.price, format.mintick) +
                         (level.isZone ? "\nZone: " + str.tostring(level.lower, format.mintick) +
                             " – " + str.tostring(level.upper, format.mintick) +
                             "\nTouches: " + str.tostring(level.touches) : "")
                )
                array.push(renderedLabels, tag)

                if showSourceZonesInput and level.isZone
                    int zoneStartTime = time - math.min(srMaxAgeInput, bar_index) * atlasBarMs
                    box zoneBox = box.new(
                         zoneStartTime,
                         level.upper,
                         time,
                         level.lower,
                         xloc = xloc.bar_time,
                         bgcolor = color.new(level.levelColor, 90),
                         border_color = color.new(level.levelColor, 65)
                    )
                    array.push(renderedBoxes, zoneBox)
