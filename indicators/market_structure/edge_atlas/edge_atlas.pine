bool custom2LowInput = input.bool(true, "Low", inline = "cs2b", tooltip = "Custom Session 2 Low.\nFreely timed session — name and hours are set above.", group = G_SESSIONS, active = presetInput == "Custom" and sessionsModuleInput and custom2EnableInput)
