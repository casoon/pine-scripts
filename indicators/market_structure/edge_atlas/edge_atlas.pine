bool fib786Input = input.bool(false, "78.6", inline = "f2", tooltip = "Very deep retracement — often marks trend exhaustion or elevated reversal risk rather than a continuation entry.", group = G_FIB, active = presetInput == "Custom" and fibModuleInput)
