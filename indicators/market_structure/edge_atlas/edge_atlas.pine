)
bool roundActive = presetInput == "Custom" ? roundModuleInput : presetInput == "Everything"
bool roundAutoStepInput = input.bool(
     true, "Automatic step",
     tooltip = "Chooses a visually useful 1/2/5 × 10ⁿ step from current price magnitude.",
     group = G_ROUND, active = roundActive
)
float roundManualStepInput = input.float(
     100.0, "Manual major step",
     minval = 0.0000001, step = 0.1,
     group = G_ROUND, active = roundActive and not roundAutoStepInput
)
bool roundMajorInput = input.bool(true, "Major", inline = "rn", tooltip = "Major whole-step levels.\nRound numbers attract resting orders and often cause price to pause, stall, or reverse nearby, independent of any chart structure.", group = G_ROUND, active = roundActive)
bool roundHalfInput = input.bool(false, "Half", inline = "rn", tooltip = "Half-step levels.\nSecondary psychological levels — usually weaker magnets than Major but still occasionally watched.", group = G_ROUND, active = roundActive)
bool roundQuarterInput = input.bool(false, "Quarter", inline = "rn", tooltip = "Quarter-step levels.\nThe weakest, most granular round-number tier — mainly useful on instruments with very fine tick sizes.", group = G_ROUND, active = roundActive)
int roundLevelsEachSideInput = input.int(
     3, "Levels each side",
     minval = 1, maxval = 20,
     group = G_ROUND, active = roundActive
)

