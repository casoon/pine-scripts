// PRESET RESOLUTION
// ============================================================================

int qualityLength =
     preset == "Very Fast" ? 10 :
     preset == "Fast"      ? 14 :
     preset == "Balanced"  ? 20 :
     preset == "Calm"      ? 30 :
     preset == "Position"  ? 45 :
     customQualityLength

int rangeLength =
     preset == "Very Fast" ? 16 :
     preset == "Fast"      ? 22 :
     preset == "Balanced"  ? 30 :
     preset == "Calm"      ? 45 :
     preset == "Position"  ? 70 :
     customRangeLength

int baselineLength =
     preset == "Very Fast" ? 18 :
     preset == "Fast"      ? 25 :
     preset == "Balanced"  ? 34 :
     preset == "Calm"      ? 50 :
     preset == "Position"  ? 80 :
     customBaselineLength

int atrLength =
     preset == "Very Fast" ? 10 :
     preset == "Fast"      ? 12 :
     preset == "Balanced"  ? 14 :
     preset == "Calm"      ? 18 :
     preset == "Position"  ? 21 :
     customAtrLength

int adxLength =
     preset == "Very Fast" ? 8 :
     preset == "Fast"      ? 10 :
     preset == "Balanced"  ? 14 :
     preset == "Calm"      ? 18 :
     preset == "Position"  ? 21 :
     customAdxLength

int rankLength =
     preset == "Very Fast" ? 80 :
     preset == "Fast"      ? 110 :
     preset == "Balanced"  ? 150 :
     preset == "Calm"      ? 220 :
     preset == "Position"  ? 350 :
     customRankLength

// Reactivity resolves how readily a state change triggers - independent of
// Preset above, which only resolves lookback lengths. "Early" loosens every
// threshold and shortens every confirmation/duration bar count so states
// change on softer, faster evidence; "Conservative" tightens both.

float structureThreshold =
     reactivity == "Early"        ? 42.0 :
     reactivity == "Balanced"     ? 55.0 :
     reactivity == "Conservative" ? 65.0 :
     customStructureThreshold

float energyLowThreshold =
     reactivity == "Early"        ? 36.0 :
     reactivity == "Balanced"     ? 30.0 :
     reactivity == "Conservative" ? 24.0 :
     customEnergyLowThreshold

float energyVeryLowThreshold =
     reactivity == "Early"        ? 23.0 :
     reactivity == "Balanced"     ? 18.0 :
     reactivity == "Conservative" ? 13.0 :
     customEnergyVeryLowThreshold

float energyHighThreshold =
     reactivity == "Early"        ? 43.0 :
     reactivity == "Balanced"     ? 53.0 :
     reactivity == "Conservative" ? 63.0 :
     customEnergyHighThreshold

float acceptanceNeutralBand =
     reactivity == "Early"        ? 12.0 :
     reactivity == "Balanced"     ? 18.0 :
     reactivity == "Conservative" ? 24.0 :
     customAcceptanceNeutralBand

float acceptancePressureThreshold =
     reactivity == "Early"        ? 16.0 :
     reactivity == "Balanced"     ? 24.0 :
     reactivity == "Conservative" ? 32.0 :
     customAcceptancePressureThreshold

float acceptanceStrongThreshold =
     reactivity == "Early"        ? 22.0 :
     reactivity == "Balanced"     ? 30.0 :
     reactivity == "Conservative" ? 38.0 :
     customAcceptanceStrongThreshold

float breakoutAcceptanceThreshold =
     reactivity == "Early"        ? 8.0 :
     reactivity == "Balanced"     ? 15.0 :
     reactivity == "Conservative" ? 22.0 :
     customBreakoutAcceptanceThreshold

int breakoutAcceptanceBars =
     reactivity == "Early"        ? 1 :
     reactivity == "Balanced"     ? 2 :
     reactivity == "Conservative" ? 3 :
     customBreakoutAcceptanceBars

int confirmationBars =
     reactivity == "Early"        ? 1 :
     reactivity == "Balanced"     ? 2 :
     reactivity == "Conservative" ? 3 :
     customConfirmationBars

int minimumStateBars =
     reactivity == "Early"        ? 1 :
     reactivity == "Balanced"     ? 3 :
     reactivity == "Conservative" ? 5 :
     customMinimumStateBars

// ============================================================================
// HELPER FUNCTIONS
// ============================================================================

f_clamp(float value, float minimum, float maximum) =>
    math.max(minimum, math.min(maximum, value))

f_safeDiv(float numerator, float denominator, float fallback) =>
    math.abs(denominator) > 0.0000001 ? numerator / denominator : fallback

f_scale(float value, float lower, float upper) =>
    float span = upper - lower
    span != 0.0 ? f_clamp((value - lower) / span, 0.0, 1.0) : 0.0

f_inverseScale(float value, float lower, float upper) =>
    1.0 - f_scale(value, lower, upper)

// Structure and Energy are properties, not good/bad verdicts - a high
// Structure in a dead downtrend is still a valid No Trade, and low Energy is
// exactly what Compression looks like. Neutral scales (blue = present/quiet,
// orange = active, gray = indistinct) avoid the green-means-go misread.

f_structureColor(float score) =>
    score >= structureThreshold ?
     color.rgb(48, 121, 170) :
     color.rgb(110, 114, 122)

f_energyColor(float score) =>
    score >= energyHighThreshold ?
     color.rgb(218, 151, 38) :
     score < energyVeryLowThreshold ?
     color.rgb(90, 120, 170) :
     color.rgb(130, 136, 145)

f_acceptanceColor(float score) =>
    score >= 20.0 ? color.rgb(31, 164, 99) :
     score <= -20.0 ? color.rgb(195, 65, 65) :
     color.rgb(130, 136, 145)

f_stateName(int state) =>
    switch state
        STATE_NO_TRADE    => "NO TRADE"
        STATE_BALANCE     => "BALANCE"
        STATE_COMPRESSION => "COMPRESSION"
        STATE_READY       => "READY"
        STATE_BREAKOUT    => "BREAKOUT"
        STATE_TREND       => "TREND"
        STATE_AFTERMATH   => "AFTERMATH"
        STATE_EXHAUSTION  => "EXHAUSTION"
        => "UNKNOWN"

f_stateKey(int state) =>
    switch state
        STATE_NO_TRADE    => "NO_TRADE"
        STATE_BALANCE     => "BALANCE"
        STATE_COMPRESSION => "COMPRESSION"
        STATE_READY       => "READY"
        STATE_BREAKOUT    => "BREAKOUT"
        STATE_TREND       => "TREND"
        STATE_AFTERMATH   => "AFTERMATH"
        STATE_EXHAUSTION  => "EXHAUSTION"
        => "UNKNOWN"

f_stateColor(int state, int transparency) =>
    color baseColor =
         state == STATE_NO_TRADE    ? color.rgb(120, 124, 132) :
         state == STATE_BALANCE     ? color.rgb(67, 105, 160) :
         state == STATE_COMPRESSION ? color.rgb(136, 91, 181) :
         state == STATE_READY       ? color.rgb(218, 151, 38) :
         state == STATE_BREAKOUT    ? color.rgb(29, 172, 119) :
         state == STATE_TREND       ? color.rgb(23, 139, 91) :
         state == STATE_AFTERMATH   ? color.rgb(150, 140, 90) :
         state == STATE_EXHAUSTION  ? color.rgb(204, 92, 52) :
         color.gray

    color.new(baseColor, transparency)

f_acceptanceText(float score) =>
    score >= 55.0  ? "STRONG UP" :
     score >= 20.0 ? "UP" :
     score <= -55.0 ? "STRONG DOWN" :
     score <= -20.0 ? "DOWN" :
     "NEUTRAL"

f_formatScore(float score) =>
    str.tostring(math.round(score))

f_supersmoother(float x, int len) =>
    float pi = math.pi
    float a1 = math.exp(-1.414 * pi / len)
    float b1 = 2.0 * a1 * math.cos(1.414 * pi / len)
    float c2 = b1
    float c3 = -(a1 * a1)
    float c1 = 1.0 - c2 - c3
    var float ss = na
    ss := c1 * (x + nz(x[1])) / 2.0 + c2 * nz(ss[1]) + c3 * nz(ss[2])
    ss

f_t3(float x, int len) =>
    float b  = 0.7
    float e1 = ta.ema(x, len)
    float e2 = ta.ema(e1, len)
    float e3 = ta.ema(e2, len)
    float e4 = ta.ema(e3, len)
    float e5 = ta.ema(e4, len)
    float e6 = ta.ema(e5, len)
    float c1 = -(b * b * b)
    float c2 =  3.0 * b * b + 3.0 * b * b * b
    float c3 = -6.0 * b * b - 3.0 * b - 3.0 * b * b * b
    float c4 =  1.0 + 3.0 * b + b * b * b + 3.0 * b * b
    c1 * e6 + c2 * e5 + c3 * e4 + c4 * e3

f_kama(float x, int len) =>
    float change   = math.abs(x - x[len])
    float vol      = math.sum(math.abs(x - x[1]), len)
    float er       = vol != 0.0 ? change / vol : 0.0
    float sc       = math.pow(er * (2.0 / 3.0 - 2.0 / 31.0) + 2.0 / 31.0, 2)
    var float kama = na
    kama := nz(kama[1], x) + sc * (x - nz(kama[1], x))
    kama

f_jma(float x, int len, int phase, float power) =>
    var float jma = na
    var float e0  = na
    var float e1  = na
    var float e2  = na
    float phaseRatio = phase < -100 ? 0.5 : phase > 100 ? 2.5 : phase / 100.0 + 1.5
    float beta        = 0.45 * (len - 1) / (0.45 * (len - 1) + 2.0)
    float alpha       = math.pow(beta, power)
    e0  := (1.0 - alpha) * x + alpha * nz(e0[1], x)
    e1  := (x - e0) * (1.0 - beta) + beta * nz(e1[1], 0.0)
    e2  := (e0 + phaseRatio * e1 - nz(jma[1], x)) * math.pow(1.0 - alpha, 2.0) + math.pow(alpha, 2.0) * nz(e2[1], 0.0)
    jma := nz(jma[1], x) + e2
    jma

f_smooth(float x, int len, string mode) =>
    switch mode
        "SMA"           => ta.sma(x, len)
        "RMA"           => ta.rma(x, len)
        "WMA"           => ta.wma(x, len)
        "SuperSmoother" => f_supersmoother(x, len)
        "T3"            => f_t3(x, len)
        "KAMA"          => f_kama(x, len)
        "JMA Approx"    => f_jma(x, len, jmaPhase, jmaPower)
        =>                 ta.ema(x, len)

// ============================================================================
// BASE CALCULATIONS
// ============================================================================

// Bar offset used everywhere a "recent trough" or "N bars ago" comparison is
// needed (energy building, momentum decay). Scales with the Quality Window
// instead of a flat hardcoded 3/5 bars, which would mean a very different
// amount of real time depending on the chart's timeframe.

int shortWindow = math.max(3, qualityLength / 4)

float atr = ta.atr(atrLength)
float atrReference = ta.ema(atr, qualityLength * 2)
float atrRatio = f_safeDiv(atr, atrReference, 1.0)

float baseline = f_smooth(close, baselineLength, baselineType)
float baselineSlope = baseline - baseline[qualityLength]
float normalizedSlope = f_safeDiv(baselineSlope, atr * math.sqrt(qualityLength), 0.0)

[plusDi, minusDi, adx] = ta.dmi(adxLength, adxLength)

float barRange = math.max(high - low, syminfo.mintick)
float bodySize = math.abs(close - open)
float bodyRatio = f_safeDiv(bodySize, barRange, 0.0)

float upperWick = high - math.max(open, close)
float lowerWick = math.min(open, close) - low
float totalWick = upperWick + lowerWick
float wickRatio = f_safeDiv(totalWick, barRange, 0.0)

float averageBodyRatio = ta.ema(bodyRatio, qualityLength)
float averageWickRatio = ta.ema(wickRatio, qualityLength)

float priceTravel = math.sum(math.abs(ta.change(close)), qualityLength)
float netMovement = math.abs(close - close[qualityLength])
float efficiencyRatio = f_safeDiv(netMovement, priceTravel, 0.0)

float directionStep =
     close > close[1] ? 1.0 :
     close < close[1] ? -1.0 :
     0.0

float signedConsistency =
     f_safeDiv(
         math.sum(directionStep, qualityLength),
         qualityLength,
         0.0
     )

float baselineCross =
     ta.cross(close, baseline) ? 1.0 : 0.0

float baselineCrossRate =
     f_safeDiv(
         math.sum(baselineCross, qualityLength),
         qualityLength,
         0.0
     )

float closeDisplacement =
     f_safeDiv(close - baseline, atr, 0.0)

// Per-bar acceptance: does the bar close near its favorable extreme (held)
// or get wicked back toward the opposite extreme (rejected)? Scaled to
// [-1, 1] and smoothed - this is the raw sensor v1 didn't have.

float upCloseStrength = f_safeDiv(close - low, barRange, 0.5) * 2.0 - 1.0
float downCloseStrength = f_safeDiv(high - close, barRange, 0.5) * 2.0 - 1.0

float barAcceptance =
     directionStep > 0.0 ? upCloseStrength :
     directionStep < 0.0 ? -downCloseStrength :
     0.0

float averageBarAcceptance = ta.ema(barAcceptance, qualityLength)

// ============================================================================
// RANGE STRUCTURE
// ============================================================================

// Previous-bar boundaries prevent the current breakout candle from moving
// its own breakout threshold.

float rollingRangeHigh = ta.highest(high[1], rangeLength)
float rollingRangeLow = ta.lowest(low[1], rangeLength)
float rollingRangeWidth = rollingRangeHigh - rollingRangeLow
float rangeWidthAtr = f_safeDiv(rollingRangeWidth, atr, maximumRangeAtr * 2.0)

float rangePosition =
     f_safeDiv(
         close - rollingRangeLow,
         rollingRangeWidth,
         0.5
     )

rangePosition := f_clamp(rangePosition, 0.0, 1.0)

float previousRangeHigh =
     rollingRangeHigh[1]

float previousRangeLow =
     rollingRangeLow[1]

float upperBoundaryChange =
     f_safeDiv(
         math.abs(rollingRangeHigh - previousRangeHigh),
         atr,
         0.0
     )

float lowerBoundaryChange =
     f_safeDiv(
         math.abs(rollingRangeLow - previousRangeLow),
         atr,
         0.0
     )

float boundaryStability =
     1.0 - f_clamp(
         (upperBoundaryChange + lowerBoundaryChange) * 0.5,
         0.0,
         1.0
     )

// ============================================================================
// VOLATILITY
// ============================================================================

float basis = ta.sma(close, qualityLength)
float deviation = ta.stdev(close, qualityLength)
float bandWidth = f_safeDiv(deviation * 4.0, basis, 0.0)
float bandWidthReference = ta.ema(bandWidth, qualityLength * 2)
float bandWidthRatio = f_safeDiv(bandWidth, bandWidthReference, 1.0)

// Ranked against its own recent history (rankLength) instead of a fixed
// constant, so the same script generalizes across timeframes/instruments
// without needing separate hand-tuned magic numbers per chart.

float volatilityExpansionScore =
     ta.percentrank(atrRatio, rankLength)

// ============================================================================
// VOLUME
// ============================================================================

// Volume is an external confirmation signal, not a price-derived property -
// it stays a standalone gate on Breakout rather than being folded into one
// of the three scores.

float volumeReference = ta.ema(volume, qualityLength)
float volumeRatio =
     na(volume) or na(volumeReference) ?
     1.0 :
     f_safeDiv(volume, volumeReference, 1.0)

bool volumeConfirmed =
     not requireVolumeConfirmation or
     na(volume) or
     volumeRatio >= volumeConfirmationRatio

// ============================================================================
// STRUCTURE
// ============================================================================

// Is there a coherent framework right now - a respected range or a clean
// trend? Rather than average the two together (which would understate a
// market that's clearly one or the other), take whichever framework
// currently fits better.

// A single bar without a new rolling extreme is not enough evidence for a
// respected range. Smooth boundary stability across the Quality Window so a
// range framework requires sustained, not momentary, boundary persistence.

float sustainedBoundaryStability =
     ta.ema(boundaryStability, qualityLength)

// Boundary persistence alone stays high in a directional market whenever only
// one side of the window advances. Require the rolling range to be compact as
// well. The geometric mean makes both properties necessary without another
// hand-tuned weight; Max Range Width remains the user-facing scale anchor.

float rangeCompactness =
     f_inverseScale(
         rangeWidthAtr,
         maximumRangeAtr * 0.5,
         maximumRangeAtr
     )

float rangeStructureQuality =
     math.sqrt(sustainedBoundaryStability * rangeCompactness) * 100.0

// Rare baseline crosses alone don't make a clean trend - a quiet drift that
// happens to sit on one side of a slow baseline would score high. Blend the
// cross rate with efficiency, ADX, slope and directional consistency so a
// high trend quality actually means "directed and efficient".

float trendCrossQuality =
     ta.percentrank(-baselineCrossRate, rankLength)

float trendEfficiencyQuality =
     ta.percentrank(efficiencyRatio, rankLength)

float trendAdxQuality =
     ta.percentrank(adx, rankLength)

// Ranked against their own recent history like the other three components,
// not a fixed f_scale/multiply-by-100 - those average well below 50 (strong
// slope/consistency readings are rare by nature), which silently dragged the
// whole composite's average below the Structure Threshold regardless of
// instrument or timeframe.

float trendSlopeQuality =
     ta.percentrank(math.abs(normalizedSlope), rankLength)

float trendConsistencyQuality =
     ta.percentrank(math.abs(signedConsistency), rankLength)

float trendStructureQuality =
     trendCrossQuality       * 0.25 +
     trendEfficiencyQuality  * 0.25 +
     trendAdxQuality         * 0.20 +
     trendSlopeQuality       * 0.20 +
     trendConsistencyQuality * 0.10

float structureScore = math.max(rangeStructureQuality, trendStructureQuality)

bool rangeFramework = rangeStructureQuality >= trendStructureQuality

// ============================================================================
// ACCEPTANCE
// ============================================================================

// Are new prices being validated or rejected, and which way? Signed -100
// (strong rejection/down) to +100 (strong acceptance/up).

float slopeDirection =
     f_clamp(normalizedSlope / 0.75, -1.0, 1.0)

float baselineDirection =
     f_clamp(closeDisplacement / 2.0, -1.0, 1.0)

float diDenominator = plusDi + minusDi
float diDirection =
     f_safeDiv(plusDi - minusDi, diDenominator, 0.0)

float rangePressure =
     f_clamp((rangePosition - 0.5) * 2.0, -1.0, 1.0)

float acceptanceScore =
     (
         slopeDirection * 0.22 +
         baselineDirection * 0.16 +
         diDirection * 0.16 +
         signedConsistency * 0.14 +
         rangePressure * 0.12 +
         averageBarAcceptance * 0.20
     ) * 100.0

acceptanceScore := f_clamp(acceptanceScore, -100.0, 100.0)

// ============================================================================
// ENERGY
// ============================================================================

// Is movement intensity building or fading? Volatility expansion, how
// efficiently movement converts into net progress, whether directional
// conviction is accelerating, and candle commitment.

float energyEfficiency =
     ta.percentrank(efficiencyRatio, rankLength)

// acceptanceScore is already homogenized into a fixed -100..100 range by
// construction, so its bar-to-bar delta doesn't need ranking the same way a
// raw ratio does - only the bar offset needs to scale with the timeframe.

float acceptanceMagnitudeChange =
     math.abs(acceptanceScore) -
     math.abs(acceptanceScore[shortWindow])

// This component measures positive acceleration only.
// Flat or declining acceptance magnitude contributes zero energy instead of
// receiving a neutral midpoint contribution of 50.

float energyMomentumAccel =
     f_clamp(
         acceptanceMagnitudeChange / 20.0,
         0.0,
         1.0
     ) * 100.0

float candleCommitmentScore =
     ta.percentrank(averageBodyRatio, rankLength)

float energyScore =
     volatilityExpansionScore * 0.30 +
     energyEfficiency * 0.30 +
     energyMomentumAccel * 0.20 +
     candleCommitmentScore * 0.20

energyScore := f_clamp(energyScore, 0.0, 100.0)

// ============================================================================
// TRANSITION CONDITIONS
// ============================================================================

bool dataReady =
     bar_index >
     math.max(
         math.max(
             rangeLength * 2 + 5,
             qualityLength * 3 + 5
         ),
         rankLength
     )

// Tracks bars since the last confirmed breakout condition. Read here at the
// previous bar's value (updated further down, once breakoutCondition for
// this bar is known) to gate re-entry into Balance without a forward
// reference to the later breakout-logic block.

var int barsSinceBreakout = 100000

bool balanceAllowed =
     barsSinceBreakout > postBreakoutLockBars

bool hasFramework =
     structureScore >= structureThreshold

bool establishedBalance =
     dataReady and
     balanceAllowed and
     hasFramework and
     rangeFramework and
     energyScore < energyLowThreshold and
     math.abs(acceptanceScore) < acceptanceNeutralBand and
     rangeWidthAtr <= maximumRangeAtr

bool establishedCompression =
     dataReady and
     establishedBalance and
     energyScore < energyVeryLowThreshold

bool nearUpperBoundary =
     rangePosition >= 0.68

bool nearLowerBoundary =
     rangePosition <= 0.32

// Energy building: volatility has bottomed out (a squeeze) and is now
// ticking up off that trough.

float atrRatioTrough = ta.lowest(atrRatio, shortWindow)
float bandWidthRatioTrough = ta.lowest(bandWidthRatio, shortWindow)

bool energyBuilding =
     atrRatio > atrRatioTrough * 1.03 or
     bandWidthRatio > bandWidthRatioTrough * 1.03

bool bullishPressure =
     acceptanceScore >= acceptancePressureThreshold and
     nearUpperBoundary

bool bearishPressure =
     acceptanceScore <= -acceptancePressureThreshold and
     nearLowerBoundary

// ----------------------------------------------------------------------------
// Armed balance / breakout logic
// ----------------------------------------------------------------------------

// The rolling range window would chase the breakout bars: one bar after a
// breakout, high[1] already contains the first breakout bar, so a multi-bar
// acceptance check against the rolling boundary demands ever-new highs/lows
// instead of "price holds outside the same range". Freeze the boundaries
// while a balance is established and measure the breakout against those.
//
// READY has the mirrored problem: requiring neutral acceptance (compression)
// and directional pressure on the same bar is contradictory at every
// reactivity level. Compression arms a memory state instead; READY then only
// needs pressure to appear while that armed compression is still valid.

var float armedRangeHigh = na
var float armedRangeLow = na
var bool breakoutArmed = false
var bool compressionArmed = false
var int barsSinceBalance = 100000

barsSinceBalance := establishedBalance ? 0 : barsSinceBalance + 1

if establishedBalance
    armedRangeHigh := rollingRangeHigh
    armedRangeLow := rollingRangeLow
    breakoutArmed := true

if establishedCompression
    compressionArmed := true

// An armed balance that hasn't re-confirmed within its own window width is
// stale - the frozen boundaries no longer describe the current market.

if barsSinceBalance > rangeLength
    breakoutArmed := false
    compressionArmed := false

if not rangeFramework
    compressionArmed := false

float breakoutReferenceHigh =
     breakoutArmed and not na(armedRangeHigh) ?
     armedRangeHigh :
     rollingRangeHigh

float breakoutReferenceLow =
     breakoutArmed and not na(armedRangeLow) ?
     armedRangeLow :
     rollingRangeLow

float breakoutBuffer = atr * breakoutBufferAtr

// ============================================================================
// BOUNDARY QUALITY / FATIGUE
// ============================================================================

// Consecutive bars pressing against one boundary count as one test sequence,
// not as multiple independent tests.

int boundaryTestCooldownBars =
     boundaryTestCooldownBarsInput > 0 ?
     boundaryTestCooldownBarsInput :
     math.max(2, qualityLength / 5)

float boundaryTouchBuffer =
     atr * boundaryTouchDistanceAtr

bool upperBoundaryContact =
     dataReady and
     breakoutArmed and
     not na(breakoutReferenceHigh) and
     high >= breakoutReferenceHigh - boundaryTouchBuffer and
     close <= breakoutReferenceHigh + breakoutBuffer

bool lowerBoundaryContact =
     dataReady and
     breakoutArmed and
     not na(breakoutReferenceLow) and
     low <= breakoutReferenceLow + boundaryTouchBuffer and
     close >= breakoutReferenceLow - breakoutBuffer

var int upperBoundaryTests = 0
var int lowerBoundaryTests = 0
var int lastUpperBoundaryTestBar = na
var int lastLowerBoundaryTestBar = na
var float upperRejectionQuality = na
var float lowerRejectionQuality = na
var float averageUpperRejectionQuality = na
var float averageLowerRejectionQuality = na
var int activeBalanceGeneration = 0

bool newArmedBalance =
     establishedBalance and
     (
         not establishedBalance[1] or
         not breakoutArmed[1]
     )

if newArmedBalance
    activeBalanceGeneration += 1
    upperBoundaryTests := 0
    lowerBoundaryTests := 0
    lastUpperBoundaryTestBar := na
    lastLowerBoundaryTestBar := na
    upperRejectionQuality := na
    lowerRejectionQuality := na
    averageUpperRejectionQuality := na
    averageLowerRejectionQuality := na

bool upperCooldownComplete =
     na(lastUpperBoundaryTestBar) or
     bar_index - lastUpperBoundaryTestBar >= boundaryTestCooldownBars

bool lowerCooldownComplete =
     na(lastLowerBoundaryTestBar) or
     bar_index - lastLowerBoundaryTestBar >= boundaryTestCooldownBars

bool newUpperBoundaryTest =
     upperBoundaryContact and
     upperCooldownComplete

bool newLowerBoundaryTest =
     lowerBoundaryContact and
     lowerCooldownComplete

float frozenRangeWidth =
     breakoutReferenceHigh - breakoutReferenceLow

float frozenRangeMid =
     (breakoutReferenceHigh + breakoutReferenceLow) * 0.5

// A close at the boundary has rejection quality 0.
// A close at or beyond the range midpoint has rejection quality 1.

float currentUpperRejectionQuality =
     newUpperBoundaryTest ?
     f_clamp(
         f_safeDiv(
             breakoutReferenceHigh - close,
             breakoutReferenceHigh - frozenRangeMid,
             0.0
         ),
         0.0,
         1.0
     ) :
     na

float currentLowerRejectionQuality =
     newLowerBoundaryTest ?
     f_clamp(
         f_safeDiv(
             close - breakoutReferenceLow,
             frozenRangeMid - breakoutReferenceLow,
             0.0
         ),
         0.0,
         1.0
     ) :
     na

if newUpperBoundaryTest
    upperBoundaryTests += 1
    lastUpperBoundaryTestBar := bar_index
    upperRejectionQuality := currentUpperRejectionQuality
    averageUpperRejectionQuality :=
         na(averageUpperRejectionQuality) ?
         currentUpperRejectionQuality :
         averageUpperRejectionQuality * 0.70 +
         currentUpperRejectionQuality * 0.30

if newLowerBoundaryTest
    lowerBoundaryTests += 1
    lastLowerBoundaryTestBar := bar_index
    lowerRejectionQuality := currentLowerRejectionQuality
    averageLowerRejectionQuality :=
         na(averageLowerRejectionQuality) ?
         currentLowerRejectionQuality :
         averageLowerRejectionQuality * 0.70 +
         currentLowerRejectionQuality * 0.30

bool upperBoundaryFresh =
     upperBoundaryTests <= boundaryFreshTestMaximum

bool lowerBoundaryFresh =
     lowerBoundaryTests <= boundaryFreshTestMaximum

bool upperBoundaryRepeatedlyTested =
     upperBoundaryTests >= boundaryStressedTestMinimum

bool lowerBoundaryRepeatedlyTested =
     lowerBoundaryTests >= boundaryStressedTestMinimum

bool upperRejectionWeak =
     upperBoundaryRepeatedlyTested and
     not na(averageUpperRejectionQuality) and
     averageUpperRejectionQuality < weakRejectionThreshold

bool lowerRejectionWeak =
     lowerBoundaryRepeatedlyTested and
     not na(averageLowerRejectionQuality) and
     averageLowerRejectionQuality < weakRejectionThreshold

// Boundary stress means repeated attacks plus weak rotational rejection.
// Test count alone is not enough: repeated strong rejection can still
// describe a respected range boundary.

bool bullishBoundaryStress =
     upperBoundaryRepeatedlyTested and
     upperBoundaryTests > lowerBoundaryTests and
     (
         upperRejectionWeak or
         acceptanceScore >= acceptancePressureThreshold
     )

bool bearishBoundaryStress =
     lowerBoundaryRepeatedlyTested and
     lowerBoundaryTests > upperBoundaryTests and
     (
         lowerRejectionWeak or
         acceptanceScore <= -acceptancePressureThreshold
     )

float upperBoundaryFatigue =
     f_clamp(
         f_safeDiv(
             upperBoundaryTests - boundaryFreshTestMaximum,
             math.max(
                 boundaryStressedTestMinimum -
                 boundaryFreshTestMaximum,
                 1
             ),
             0.0
         ),
         0.0,
         1.0
     ) *
     (
         na(averageUpperRejectionQuality) ?
         0.5 :
         1.0 - averageUpperRejectionQuality
     )

float lowerBoundaryFatigue =
     f_clamp(
         f_safeDiv(
             lowerBoundaryTests - boundaryFreshTestMaximum,
             math.max(
                 boundaryStressedTestMinimum -
                 boundaryFreshTestMaximum,
                 1
             ),
             0.0
         ),
         0.0,
         1.0
     ) *
     (
         na(averageLowerRejectionQuality) ?
         0.5 :
         1.0 - averageLowerRejectionQuality
     )

float dominantBoundaryFatigue =
     math.max(
         upperBoundaryFatigue,
         lowerBoundaryFatigue
     )

int dominantBoundaryDirection =
     upperBoundaryFatigue > lowerBoundaryFatigue ? 1 :
     lowerBoundaryFatigue > upperBoundaryFatigue ? -1 :
     0

bool rawBullishBreakout =
     dataReady and
     breakoutArmed and
     close > breakoutReferenceHigh + breakoutBuffer

bool rawBearishBreakout =
     dataReady and
     breakoutArmed and
     close < breakoutReferenceLow - breakoutBuffer

// ----------------------------------------------------------------------------
// Failed breakout / boundary sweep
// ----------------------------------------------------------------------------

// A failed breakout is evaluated from the wick excursion, not from the raw
// breakout condition, because raw breakout requires the close itself to be
// outside the balance.

bool bullishBoundarySweep =
     detectFailedBreakouts and
     dataReady and
     breakoutArmed and
     high > breakoutReferenceHigh + breakoutBuffer and
     close <= breakoutReferenceHigh - atr * failedBreakoutReentryAtr

bool bearishBoundarySweep =
     detectFailedBreakouts and
     dataReady and
     breakoutArmed and
     low < breakoutReferenceLow - breakoutBuffer and
     close >= breakoutReferenceLow + atr * failedBreakoutReentryAtr

bool bullishFailedBreakout =
     bullishBoundarySweep and
     barAcceptance < 0.0

bool bearishFailedBreakout =
     bearishBoundarySweep and
     barAcceptance > 0.0

bool failedBreakoutCondition =
     bullishFailedBreakout or
     bearishFailedBreakout

// Acceptance: require price to hold beyond the boundary for several bars in
// a row instead of confirming off a single spike candle.

var int bullishAcceptanceStreak = 0
var int bearishAcceptanceStreak = 0

bullishAcceptanceStreak := rawBullishBreakout ? bullishAcceptanceStreak + 1 : 0
bearishAcceptanceStreak := rawBearishBreakout ? bearishAcceptanceStreak + 1 : 0

if bullishFailedBreakout
    bullishAcceptanceStreak := 0

if bearishFailedBreakout
    bearishAcceptanceStreak := 0

bool bullishHeld = bullishAcceptanceStreak >= breakoutAcceptanceBars
bool bearishHeld = bearishAcceptanceStreak >= breakoutAcceptanceBars

bool bullishBreakout =
     rawBullishBreakout and
     bullishHeld and
     acceptanceScore >= breakoutAcceptanceThreshold and
     energyScore >= energyHighThreshold and
     volumeConfirmed

bool bearishBreakout =
     rawBearishBreakout and
     bearishHeld and
     acceptanceScore <= -breakoutAcceptanceThreshold and
     energyScore >= energyHighThreshold and
     volumeConfirmed

bool breakoutCondition =
     bullishBreakout or bearishBreakout

if breakoutCondition
    barsSinceBreakout := 0
    breakoutArmed := false
    compressionArmed := false
else
    barsSinceBreakout += 1

bool bullishReadyPressure =
     bullishPressure and
     (
         not requireBoundaryStressForReady or
         bullishBoundaryStress
     )

bool bearishReadyPressure =
     bearishPressure and
     (
         not requireBoundaryStressForReady or
         bearishBoundaryStress
     )

bool readyCondition =
     compressionArmed and
     energyBuilding and
     (
         bullishReadyPressure or
         bearishReadyPressure
     )

// ----------------------------------------------------------------------------
// Trend and exhaustion
// ----------------------------------------------------------------------------

bool bullishTrend =
     hasFramework and
     not rangeFramework and
     energyScore >= energyHighThreshold and
     acceptanceScore >= acceptanceStrongThreshold and
     close > baseline

bool bearishTrend =
     hasFramework and
     not rangeFramework and
     energyScore >= energyHighThreshold and
     acceptanceScore <= -acceptanceStrongThreshold and
     close < baseline

bool trendCondition =
     bullishTrend or bearishTrend

float extensionFromBaseline =
     math.abs(f_safeDiv(close - baseline, atr, 0.0))

bool energyDecay =
     energyScore < energyScore[shortWindow]

bool exhaustionCondition =
     trendCondition and
     extensionFromBaseline >= 2.6 and
     (
         energyDecay or
         ta.percentrank(averageWickRatio, rankLength) >= 80.0 or
         ta.percentrank(atrRatio, rankLength) >= 90.0
     )

// ----------------------------------------------------------------------------
// Impulse aftermath
// ----------------------------------------------------------------------------

// Energy and acceptance must peak on the same bar to count as one impulse -
// two separate highs inside the lookback are two unrelated events, not an
// impulse. The impulse direction is stored so Aftermath stays attributable
// to the move that actually caused it.

bool impulseBar =
     energyScore >= recentImpulseEnergyThreshold and
     math.abs(acceptanceScore) >= recentImpulseAcceptanceThreshold

var int impulseDirection = 0

if impulseBar
    impulseDirection := acceptanceScore > 0.0 ? 1 : -1

bool recentImpulse =
     ta.barssince(impulseBar) <= impulseLookback

bool impulseAftermath =
     recentImpulse and
     energyScore <= aftermathEnergyMax and
     atrRatio <= atrRatio[3]

// ============================================================================
// STATE CANDIDATE
// ============================================================================

int candidateState =
     not dataReady          ? STATE_NO_TRADE :
     breakoutCondition      ? STATE_BREAKOUT :
     exhaustionCondition    ? STATE_EXHAUSTION :
     trendCondition         ? STATE_TREND :
     readyCondition         ? STATE_READY :
     impulseAftermath       ? STATE_AFTERMATH :
     establishedCompression ? STATE_COMPRESSION :
     establishedBalance     ? STATE_BALANCE :
     STATE_NO_TRADE

// NO_TRADE is the fallback when no named setup/regime is currently proven.
// Record the dominant blocker so offline analysis can distinguish genuinely
// poor structure from a nearly-qualified transition instead of treating every
// fallback bar as the same market condition.

bool anyRawBreakout =
     rawBullishBreakout or rawBearishBreakout

bool breakoutHoldPending =
     (rawBullishBreakout and not bullishHeld) or
     (rawBearishBreakout and not bearishHeld)

bool breakoutAcceptanceWeak =
     (rawBullishBreakout and bullishHeld and acceptanceScore < breakoutAcceptanceThreshold) or
     (rawBearishBreakout and bearishHeld and acceptanceScore > -breakoutAcceptanceThreshold)

string noTradeReason =
     candidateState != STATE_NO_TRADE ? "NONE" :
     not dataReady ? "WARMUP" :
     not hasFramework ? "NO_FRAMEWORK" :
     bullishFailedBreakout ? "FAILED_BREAKOUT_UP" :
     bearishFailedBreakout ? "FAILED_BREAKOUT_DOWN" :
     anyRawBreakout and breakoutHoldPending ? "BREAKOUT_HOLD_PENDING" :
     anyRawBreakout and energyScore < energyHighThreshold ? "BREAKOUT_ENERGY_LOW" :
     anyRawBreakout and breakoutAcceptanceWeak ? "BREAKOUT_ACCEPTANCE_WEAK" :
     anyRawBreakout and not volumeConfirmed ? "BREAKOUT_VOLUME_WEAK" :
     rangeFramework and not balanceAllowed ? "POST_BREAKOUT_LOCK" :
     rangeFramework and rangeWidthAtr > maximumRangeAtr ? "RANGE_TOO_WIDE" :
     rangeFramework and compressionArmed and not energyBuilding ?
          "READY_ENERGY_FLAT" :
     rangeFramework and compressionArmed and energyBuilding and
     requireBoundaryStressForReady and
     not bullishBoundaryStress and
     not bearishBoundaryStress ?
          "READY_BOUNDARY_STRESS_MISSING" :
     rangeFramework and compressionArmed and energyBuilding ?
          "READY_NO_BOUNDARY_PRESSURE" :
     rangeFramework and upperRejectionWeak and acceptanceScore > 0.0 ?
          "UPPER_BOUNDARY_FATIGUED" :
     rangeFramework and lowerRejectionWeak and acceptanceScore < 0.0 ?
          "LOWER_BOUNDARY_FATIGUED" :
     rangeFramework and energyScore >= energyHighThreshold ? "RANGE_EXPANSION_UNCONFIRMED" :
     rangeFramework and energyScore >= energyLowThreshold ? "RANGE_MID_ENERGY" :
     rangeFramework and math.abs(acceptanceScore) >= acceptanceNeutralBand ? "RANGE_DIRECTIONAL_UNCONFIRMED" :
     rangeFramework ? "RANGE_UNCLASSIFIED" :
     energyScore < energyHighThreshold ? "TREND_ENERGY_LOW" :
     math.abs(acceptanceScore) < acceptanceStrongThreshold ? "TREND_ACCEPTANCE_WEAK" :
     "TREND_DIRECTION_MISMATCH"

// ============================================================================
// STATE MACHINE
// ============================================================================

var int marketState = STATE_NO_TRADE
var int pendingState = STATE_NO_TRADE
var int pendingStateBars = 0
var int invalidCurrentStateBars = 0
var int stateBars = 0
var int breakoutBarsRemaining = 0
var int activeDirection = 0

// Track one specific target state. Alternating candidates no longer combine
// into a false confirmation merely because all of them disagree with the
// current confirmed state.

if candidateState == marketState
    pendingState := marketState
    pendingStateBars := 0
else if candidateState == pendingState
    pendingStateBars += 1
else
    pendingState := candidateState
    pendingStateBars := 1

if bullishBreakout
    activeDirection := 1
else if bearishBreakout
    activeDirection := -1
else if marketState == STATE_TREND
    if acceptanceScore >= 20.0
        activeDirection := 1
    else if acceptanceScore <= -20.0
        activeDirection := -1

if breakoutCondition
    breakoutBarsRemaining := breakoutHoldBars

if breakoutBarsRemaining > 0
    breakoutBarsRemaining -= 1

bool forceBreakout =
     pendingState == STATE_BREAKOUT

bool holdBreakout =
     marketState == STATE_BREAKOUT and
     breakoutBarsRemaining > 0 and
     not exhaustionCondition

// Separate state invalidation from target-state confirmation. This prevents
// stale-state lock without allowing candidate churn to confirm an arbitrary
// one-bar target.

bool currentStateStillValid =
     marketState == STATE_NO_TRADE ?
         candidateState == STATE_NO_TRADE :
     marketState == STATE_BALANCE ?
         establishedBalance :
     marketState == STATE_COMPRESSION ?
         establishedCompression or
         readyCondition :
     marketState == STATE_READY ?
         compressionArmed and
         (
             readyCondition or
             energyBuilding
         ) :
     marketState == STATE_BREAKOUT ?
         breakoutBarsRemaining > 0 or
         trendCondition :
     marketState == STATE_TREND ?
         trendCondition or
         exhaustionCondition :
     marketState == STATE_AFTERMATH ?
         impulseAftermath :
     marketState == STATE_EXHAUSTION ?
         exhaustionCondition :
     false

invalidCurrentStateBars :=
     currentStateStillValid ?
     0 :
     invalidCurrentStateBars + 1

bool currentStateInvalidated =
     invalidCurrentStateBars >= confirmationBars

bool mayLeaveCurrentState =
     stateBars >= minimumStateBars or
     forceBreakout or
     marketState == STATE_BREAKOUT or
     currentStateInvalidated

int requiredConfirmation =
     pendingState == STATE_BREAKOUT ?
     1 :
     pendingState == STATE_NO_TRADE ?
     confirmationBars + 1 :
     confirmationBars

bool pendingStateConfirmed =
     pendingState != marketState and
     pendingStateBars >= requiredConfirmation

int previousMarketState = marketState
int previousStateBars = stateBars

if holdBreakout
    marketState := STATE_BREAKOUT
    stateBars += 1
else if pendingStateConfirmed and mayLeaveCurrentState
    marketState := pendingState
    stateBars := 0
    pendingStateBars := 0
    invalidCurrentStateBars := 0
else
    stateBars += 1

// ============================================================================
// STATE EVENTS
// ============================================================================

bool stateChanged =
     marketState != marketState[1]

bool enteredNoTrade =
     stateChanged and marketState == STATE_NO_TRADE

bool enteredBalance =
     stateChanged and marketState == STATE_BALANCE

bool enteredCompression =
     stateChanged and marketState == STATE_COMPRESSION

bool enteredReady =
     stateChanged and marketState == STATE_READY

bool enteredBreakout =
     stateChanged and marketState == STATE_BREAKOUT

bool enteredTrend =
     stateChanged and marketState == STATE_TREND

bool enteredAftermath =
     stateChanged and marketState == STATE_AFTERMATH

bool enteredExhaustion =
     stateChanged and marketState == STATE_EXHAUSTION

bool bullishBreakoutEvent =
     enteredBreakout and activeDirection == 1

bool bearishBreakoutEvent =
     enteredBreakout and activeDirection == -1

bool bullishReadyEvent =
     enteredReady and acceptanceScore > 0.0

bool bearishReadyEvent =
     enteredReady and acceptanceScore < 0.0

// The event is independent of the state change. It can occur inside
// BALANCE, COMPRESSION, or READY.

bool bullishFailedBreakoutEvent =
     bullishFailedBreakout and
     not bullishFailedBreakout[1]

bool bearishFailedBreakoutEvent =
     bearishFailedBreakout and
     not bearishFailedBreakout[1]

// Marking every No-Trade entry drowns the chart in stop-like markers. Only
// the transitions that actually end a tradable phase are worth a marker.

bool leftTradableState =
     enteredNoTrade and
     (
         marketState[1] == STATE_READY or
         marketState[1] == STATE_BREAKOUT or
         marketState[1] == STATE_TREND
     )

// ============================================================================
// CALIBRATION LOGGING
// ============================================================================

// Event-prefixed MTE2 (vs. v1's MTE) so separately exported Pine Logs from
// both indicators can be joined by timestamp without mixing event schemas.

var bool calibrationConfigLogged = false

if enableCalibrationLog and not calibrationConfigLogged and barstate.isconfirmed
    log.info(str.format(
         'MTE2 CONFIG | modelVersion=2.5.0 | preset={0} | reactivity={1} | qualityLen={2} | rangeLen={3} | baselineLen={4} | atrLen={5} | adxLen={6} | rankLen={7} | baselineType={8} | structureTh={9} | maxRangeAtr={10} | energyLowTh={11} | energyVeryLowTh={12} | energyHighTh={13} | acceptNeutral={14} | acceptPressure={15} | acceptStrong={16} | breakoutAcceptTh={17} | breakoutBufferAtr={18} | breakoutAcceptBars={19} | confirmBars={20} | minStateBars={21} | breakoutHoldBars={22} | postBreakoutLockBars={23} | impulseLookback={24} | recentImpulseEnergyTh={25} | recentImpulseAcceptTh={26} | aftermathEnergyMax={27} | tf={28} | symbol={29} | requireVolume={30} | volumeFactor={31} | jmaPhase={32} | jmaPower={33} | boundaryTouchDistanceAtr={34} | boundaryTestCooldownBars={35} | boundaryFreshTestMax={36} | boundaryStressedTestMin={37} | weakRejectionTh={38} | requireBoundaryStressForReady={39} | detectFailedBreakouts={40} | failedBreakoutReentryAtr={41}',
         preset, reactivity, qualityLength, rangeLength, baselineLength, atrLength, adxLength, rankLength, baselineType,
         str.tostring(structureThreshold, '#.#'), str.tostring(maximumRangeAtr, '#.##'),
         str.tostring(energyLowThreshold, '#.#'), str.tostring(energyVeryLowThreshold, '#.#'),
         str.tostring(energyHighThreshold, '#.#'), str.tostring(acceptanceNeutralBand, '#.#'),
         str.tostring(acceptancePressureThreshold, '#.#'), str.tostring(acceptanceStrongThreshold, '#.#'),
         str.tostring(breakoutAcceptanceThreshold, '#.#'), str.tostring(breakoutBufferAtr, '#.##'),
         breakoutAcceptanceBars, confirmationBars, minimumStateBars, breakoutHoldBars,
         postBreakoutLockBars, impulseLookback,
         str.tostring(recentImpulseEnergyThreshold, '#.#'), str.tostring(recentImpulseAcceptanceThreshold, '#.#'),
         str.tostring(aftermathEnergyMax, '#.#'),
         timeframe.period, syminfo.tickerid,
         str.tostring(requireVolumeConfirmation), str.tostring(volumeConfirmationRatio, '#.##'),
         jmaPhase, str.tostring(jmaPower, '#.##'),
         str.tostring(boundaryTouchDistanceAtr, '#.##'), boundaryTestCooldownBarsInput,
         boundaryFreshTestMaximum, boundaryStressedTestMinimum,
         str.tostring(weakRejectionThreshold, '#.##'), str.tostring(requireBoundaryStressForReady),
         str.tostring(detectFailedBreakouts), str.tostring(failedBreakoutReentryAtr, '#.##')
    ))
    calibrationConfigLogged := true

if enableCalibrationLog and barstate.isconfirmed
    log.info(
         'MTE2 CAL' +
         ' | bar=' + str.tostring(bar_index) +
         ' | time=' + str.tostring(time) +
         ' | symbol=' + syminfo.tickerid +
         ' | tf=' + timeframe.period +
         ' | state=' + f_stateKey(marketState) +
         ' | candidate=' + f_stateKey(candidateState) +
         ' | noTradeReason=' + noTradeReason +
         ' | open=' + str.tostring(open, format.mintick) +
         ' | high=' + str.tostring(high, format.mintick) +
         ' | low=' + str.tostring(low, format.mintick) +
         ' | close=' + str.tostring(close, format.mintick) +
         ' | atr=' + str.tostring(atr, format.mintick) +
         ' | structure=' + str.tostring(structureScore, '#.##') +
         ' | rangeStructure=' + str.tostring(rangeStructureQuality, '#.##') +
         ' | rangeCompactness=' + str.tostring(rangeCompactness, '#.###') +
         ' | trendStructure=' + str.tostring(trendStructureQuality, '#.##') +
         ' | trendCross=' + str.tostring(trendCrossQuality, '#.##') +
         ' | trendEfficiency=' + str.tostring(trendEfficiencyQuality, '#.##') +
         ' | trendAdx=' + str.tostring(trendAdxQuality, '#.##') +
         ' | trendSlope=' + str.tostring(trendSlopeQuality, '#.##') +
         ' | trendConsistency=' + str.tostring(trendConsistencyQuality, '#.##') +
         ' | energy=' + str.tostring(energyScore, '#.##') +
         ' | acceptance=' + str.tostring(acceptanceScore, '#.##') +
         ' | dataReady=' + str.tostring(dataReady) +
         ' | hasFramework=' + str.tostring(hasFramework) +
         ' | rangeFramework=' + str.tostring(rangeFramework) +
         ' | balanceAllowed=' + str.tostring(balanceAllowed) +
         ' | balance=' + str.tostring(establishedBalance) +
         ' | compression=' + str.tostring(establishedCompression) +
         ' | ready=' + str.tostring(readyCondition) +
         ' | breakout=' + str.tostring(breakoutCondition) +
         ' | trend=' + str.tostring(trendCondition) +
         ' | aftermath=' + str.tostring(impulseAftermath) +
         ' | exhaustion=' + str.tostring(exhaustionCondition) +
         ' | energyBuilding=' + str.tostring(energyBuilding) +
         ' | bullPressure=' + str.tostring(bullishPressure) +
         ' | bearPressure=' + str.tostring(bearishPressure) +
         ' | rawBullBreak=' + str.tostring(rawBullishBreakout) +
         ' | rawBearBreak=' + str.tostring(rawBearishBreakout) +
         ' | volumeConfirmed=' + str.tostring(volumeConfirmed) +
         ' | compressionArmed=' + str.tostring(compressionArmed) +
         ' | breakoutArmed=' + str.tostring(breakoutArmed) +
         ' | bullHoldStreak=' + str.tostring(bullishAcceptanceStreak) +
         ' | bearHoldStreak=' + str.tostring(bearishAcceptanceStreak) +
         ' | pendingState=' + f_stateKey(pendingState) +
         ' | pendingStateBars=' + str.tostring(pendingStateBars) +
         ' | invalidCurrentStateBars=' + str.tostring(invalidCurrentStateBars) +
         ' | stateBars=' + str.tostring(stateBars) +
         ' | atrRatio=' + str.tostring(atrRatio, '#.###') +
         ' | bandWidthRatio=' + str.tostring(bandWidthRatio, '#.###') +
         ' | rangeWidthAtr=' + str.tostring(rangeWidthAtr, '#.##') +
         ' | efficiencyRatio=' + str.tostring(efficiencyRatio, '#.###') +
         ' | adx=' + str.tostring(adx, '#.##') +
         ' | boundaryStability=' + str.tostring(boundaryStability, '#.###') +
         ' | sustainedBoundaryStability=' + str.tostring(sustainedBoundaryStability, '#.###') +
         ' | rangePosition=' + str.tostring(rangePosition, '#.###') +
         ' | volumeRatio=' + str.tostring(volumeRatio, '#.###') +
         ' | bodyRatio=' + str.tostring(bodyRatio, '#.###') +
         ' | wickRatio=' + str.tostring(wickRatio, '#.###') +
         ' | activeBalanceGeneration=' + str.tostring(activeBalanceGeneration) +
         ' | upperBoundaryTests=' + str.tostring(upperBoundaryTests) +
         ' | lowerBoundaryTests=' + str.tostring(lowerBoundaryTests) +
         ' | upperBoundaryFresh=' + str.tostring(upperBoundaryFresh) +
         ' | lowerBoundaryFresh=' + str.tostring(lowerBoundaryFresh) +
         ' | upperRejectionQuality=' + str.tostring(upperRejectionQuality, '#.###') +
         ' | lowerRejectionQuality=' + str.tostring(lowerRejectionQuality, '#.###') +
         ' | avgUpperRejectionQuality=' + str.tostring(averageUpperRejectionQuality, '#.###') +
         ' | avgLowerRejectionQuality=' + str.tostring(averageLowerRejectionQuality, '#.###') +
         ' | upperBoundaryFatigue=' + str.tostring(upperBoundaryFatigue, '#.###') +
         ' | lowerBoundaryFatigue=' + str.tostring(lowerBoundaryFatigue, '#.###') +
         ' | dominantBoundaryFatigue=' + str.tostring(dominantBoundaryFatigue, '#.###') +
         ' | bullishBoundaryStress=' + str.tostring(bullishBoundaryStress) +
         ' | bearishBoundaryStress=' + str.tostring(bearishBoundaryStress) +
         ' | bullishFailedBreakout=' + str.tostring(bullishFailedBreakout) +
         ' | bearishFailedBreakout=' + str.tostring(bearishFailedBreakout)
    )

if enableCalibrationLog and stateChanged and barstate.isconfirmed
    log.info(str.format(
         'MTE2 TRANSITION | bar={0} | from={1} | to={2} | prevStateBars={3} | dirActive={4} | structure={5} | energy={6} | acceptance={7} | tf={8}',
         bar_index, f_stateKey(previousMarketState), f_stateKey(marketState),
         previousStateBars, activeDirection,
         str.tostring(structureScore, '#.##'), str.tostring(energyScore, '#.##'),
         str.tostring(acceptanceScore, '#.##'),
         timeframe.period
    ))

// ============================================================================
// VISUALS
// ============================================================================

// ----------------------------------------------------------------------------
// Background
// ----------------------------------------------------------------------------

color backgroundColor =
     marketState == STATE_NO_TRADE    ? f_stateColor(marketState, 90) :
     marketState == STATE_BALANCE     ? f_stateColor(marketState, 92) :
     marketState == STATE_COMPRESSION ? f_stateColor(marketState, 88) :
     marketState == STATE_READY       ? f_stateColor(marketState, 86) :
     marketState == STATE_BREAKOUT    ? f_stateColor(marketState, 82) :
     marketState == STATE_TREND       ? f_stateColor(marketState, 92) :
     marketState == STATE_AFTERMATH   ? f_stateColor(marketState, 88) :
     marketState == STATE_EXHAUSTION  ? f_stateColor(marketState, 86) :
     na

bgcolor(showBackground ? backgroundColor : na)

// ----------------------------------------------------------------------------
// Range boundaries
// ----------------------------------------------------------------------------

bool rangeState =
     marketState == STATE_BALANCE or
     marketState == STATE_COMPRESSION or
     marketState == STATE_READY

color rangeLineColor =
     marketState == STATE_READY ?
     color.new(f_acceptanceColor(acceptanceScore), 5) :
     marketState == STATE_COMPRESSION ?
     color.new(color.rgb(151, 101, 196), 10) :
     color.new(color.rgb(75, 112, 164), 25)

// While armed, the drawn boundary is the frozen breakout reference - the
// level the breakout is actually measured against, not the rolling window.

plotRangeHigh = plot(
     showRange and rangeState ? breakoutReferenceHigh : na,
     "Balance Upper",
     color = rangeLineColor,
     linewidth = 2,
     style = plot.style_linebr
)

plotRangeLow = plot(
     showRange and rangeState ? breakoutReferenceLow : na,
     "Balance Lower",
     color = rangeLineColor,
     linewidth = 2,
     style = plot.style_linebr
)

plotRangeMid = plot(
     showRange and rangeState ? (breakoutReferenceHigh + breakoutReferenceLow) * 0.5 : na,
     "Balance Midline",
     color = color.new(rangeLineColor, 55),
     linewidth = 1,
     style = plot.style_linebr
)

fill(
     plotRangeHigh,
     plotRangeLow,
     color = showRange and rangeState ?
         color.new(rangeLineColor, 91) :
         na,
     title = "Balance Area"
)

// ----------------------------------------------------------------------------
// Baseline
// ----------------------------------------------------------------------------

plot(
     showBaseline ? baseline : na,
     "Quality Baseline",
     color = color.new(f_acceptanceColor(acceptanceScore), 25),
     linewidth = 2
)

// ----------------------------------------------------------------------------
// Transition markers
// ----------------------------------------------------------------------------

plotshape(
     showSignals and bullishReadyEvent,
     title = "Bullish Ready",
     style = shape.diamond,
     location = location.belowbar,
     color = color.rgb(218, 151, 38),
     size = size.tiny,
     text = "R",
     textcolor = color.rgb(40, 44, 51)
)

plotshape(
     showSignals and bearishReadyEvent,
     title = "Bearish Ready",
     style = shape.diamond,
     location = location.abovebar,
     color = color.rgb(218, 151, 38),
     size = size.tiny,
     text = "R",
     textcolor = color.rgb(40, 44, 51)
)

plotshape(
     showSignals and bullishBreakoutEvent,
     title = "Bullish Balance Breakout",
     style = shape.triangleup,
     location = location.belowbar,
     color = color.rgb(24, 170, 108),
     size = size.small,
     text = "BREAK",
     textcolor = color.rgb(40, 44, 51)
)

plotshape(
     showSignals and bearishBreakoutEvent,
     title = "Bearish Balance Breakout",
     style = shape.triangledown,
     location = location.abovebar,
     color = color.rgb(197, 66, 66),
     size = size.small,
     text = "BREAK",
     textcolor = color.rgb(40, 44, 51)
)

plotshape(
     showSignals and bullishFailedBreakoutEvent,
     title = "Bullish Failed Breakout",
     style = shape.triangledown,
     location = location.abovebar,
     color = color.rgb(204, 92, 52),
     size = size.tiny,
     text = "FAIL",
     textcolor = color.white
)

plotshape(
     showSignals and bearishFailedBreakoutEvent,
     title = "Bearish Failed Breakout",
     style = shape.triangleup,
     location = location.belowbar,
     color = color.rgb(204, 92, 52),
     size = size.tiny,
     text = "FAIL",
     textcolor = color.white
)

plotshape(
     showSignals and leftTradableState,
     title = "No Trade",
     style = shape.xcross,
     location = location.abovebar,
     color = color.rgb(130, 134, 141),
     size = size.tiny,
     text = "PAUSE",
     textcolor = color.rgb(40, 44, 51)
)

plotshape(
     showSignals and enteredAftermath and impulseDirection >= 0,
     title = "Aftermath (above)",
     style = shape.square,
     location = location.abovebar,
     color = color.rgb(150, 140, 90),
     size = size.tiny,
     text = "AM",
     textcolor = color.rgb(40, 44, 51)
)

plotshape(
     showSignals and enteredAftermath and impulseDirection < 0,
     title = "Aftermath (below)",
     style = shape.square,
     location = location.belowbar,
     color = color.rgb(150, 140, 90),
     size = size.tiny,
     text = "AM",
     textcolor = color.rgb(40, 44, 51)
)

plotshape(
     showSignals and enteredExhaustion and activeDirection >= 0,
     title = "Exhaustion (above)",
     style = shape.circle,
     location = location.abovebar,
     color = color.rgb(207, 94, 49),
     size = size.tiny,
     text = "EX",
     textcolor = color.rgb(40, 44, 51)
)

plotshape(
     showSignals and enteredExhaustion and activeDirection < 0,
     title = "Exhaustion (below)",
     style = shape.circle,
     location = location.belowbar,
     color = color.rgb(207, 94, 49),
     size = size.tiny,
     text = "EX",
     textcolor = color.rgb(40, 44, 51)
)

// ----------------------------------------------------------------------------
// Data-window values
// ----------------------------------------------------------------------------

plot(
     showScorePane ? structureScore : na,
     "Structure Score",
     display = display.data_window
)

plot(
     showScorePane ? energyScore : na,
     "Energy Score",
     display = display.data_window
)

plot(
     showScorePane ? acceptanceScore : na,
     "Acceptance Score",
     display = display.data_window
)

plot(
     showScorePane ? efficiencyRatio * 100.0 : na,
     "Efficiency Ratio × 100",
     display = display.data_window
)

plot(
     showScorePane ? adx : na,
     "ADX",
     display = display.data_window
)

plot(
     showScorePane ? upperBoundaryTests : na,
     "Upper Boundary Tests",
     display = display.data_window
)

plot(
     showScorePane ? lowerBoundaryTests : na,
     "Lower Boundary Tests",
     display = display.data_window
)

plot(
     showScorePane ? upperBoundaryFatigue * 100.0 : na,
     "Upper Boundary Fatigue",
     display = display.data_window
)

plot(
     showScorePane ? lowerBoundaryFatigue * 100.0 : na,
     "Lower Boundary Fatigue",
     display = display.data_window
)

plot(
     showScorePane ? averageUpperRejectionQuality * 100.0 : na,
     "Upper Rejection Quality",
     display = display.data_window
)

plot(
     showScorePane ? averageLowerRejectionQuality * 100.0 : na,
     "Lower Rejection Quality",
     display = display.data_window
)

// ============================================================================
// DASHBOARD
// ============================================================================

// Leaner than v1 by design - Structure/Energy/Acceptance are meant to
// replace the four v1 scores, not sit alongside them.

var table dashboard = table.new(
     position.top_right,
     2,
     6,
     border_width = 1,
     frame_width = 1
)

if barstate.islast and showDashboard
    color stateColor = f_stateColor(marketState, 0)

    table.cell(
         dashboard,
         0,
         0,
         "MARKET STATE",
         text_color = color.white,
         bgcolor = color.rgb(42, 45, 51),
         text_size = size.small
    )

    table.cell(
         dashboard,
         1,
         0,
         f_stateName(marketState),
         text_color = color.white,
         bgcolor = stateColor,
         text_size = size.small
    )

    table.cell(
         dashboard,
         0,
         1,
         candidateState == STATE_NO_TRADE ? "Blocker" : "Candidate",
         text_color = color.silver,
         bgcolor = color.new(color.black, 15)
    )

    table.cell(
         dashboard,
         1,
         1,
         candidateState == STATE_NO_TRADE ? noTradeReason : f_stateName(candidateState),
         text_color = color.white,
         bgcolor = f_stateColor(candidateState, 0),
         text_size = size.tiny
    )

    table.cell(
         dashboard,
         0,
         2,
         "Structure",
         text_color = color.silver,
         bgcolor = color.new(color.black, 15)
    )

    table.cell(
         dashboard,
         1,
         2,
         f_formatScore(structureScore),
         text_color = color.white,
         bgcolor = f_structureColor(structureScore)
    )

    table.cell(
         dashboard,
         0,
         3,
         "Energy",
         text_color = color.silver,
         bgcolor = color.new(color.black, 15)
    )

    table.cell(
         dashboard,
         1,
         3,
         f_formatScore(energyScore),
         text_color = color.white,
         bgcolor = f_energyColor(energyScore)
    )

    table.cell(
         dashboard,
         0,
         4,
         "Acceptance",
         text_color = color.silver,
         bgcolor = color.new(color.black, 15)
    )

    table.cell(
         dashboard,
         1,
         4,
         f_acceptanceText(acceptanceScore),
         text_color = color.white,
         bgcolor = f_acceptanceColor(acceptanceScore)
    )

    string balanceAction =
         bullishFailedBreakout ?
         "FAILED UPSIDE BREAK" :
         bearishFailedBreakout ?
         "FAILED DOWNSIDE BREAK" :
         upperRejectionWeak and acceptanceScore > 0.0 ?
         "AVOID SHORTING UPPER EDGE" :
         lowerRejectionWeak and acceptanceScore < 0.0 ?
         "AVOID BUYING LOWER EDGE" :
         not upperBoundaryFresh or
         not lowerBoundaryFresh ?
         "WAIT FOR CONFIRMATION" :
         "TRADE FRESH EDGES"

    string actionText =
         marketState == STATE_NO_TRADE ?
         candidateState != STATE_NO_TRADE ?
         "WAITING CONFIRMATION" :
         hasFramework ?
         "NO QUALIFIED SETUP" :
         "STAND ASIDE" :
         marketState == STATE_BALANCE ?
         balanceAction :
         marketState == STATE_COMPRESSION ?
         dominantBoundaryFatigue >= 0.50 ?
         "BOUNDARY UNDER STRESS" :
         "WATCH BOUNDARIES" :
         marketState == STATE_READY ?
         "PREPARE FOR BREAKOUT" :
         marketState == STATE_BREAKOUT ?
         "CHECK RETEST / SETUP" :
         marketState == STATE_TREND ?
         "ALLOW TREND SETUPS" :
         marketState == STATE_AFTERMATH ?
         "DON'T CHASE" :
         "REDUCE RISK"

    table.cell(
         dashboard,
         0,
         5,
         "Action",
         text_color = color.silver,
         bgcolor = color.new(color.black, 15)
    )

    table.cell(
         dashboard,
         1,
         5,
         actionText,
         text_color = color.white,
         bgcolor = stateColor,
         text_size = size.small
    )

if barstate.islast and not showDashboard
    table.clear(dashboard, 0, 0, 1, 5)

// ============================================================================
// ALERT CONDITIONS
// ============================================================================

alertcondition(
     enteredNoTrade,
     "MTE2: No Trade",
     "Market Tradability Engine v2: the market has shifted into a non-tradable state."
)

alertcondition(
     enteredCompression,
     "MTE2: Compression",
     "Market Tradability Engine v2: a balance with increasing compression has been detected."
)

alertcondition(
     bullishReadyEvent,
     "MTE2: Bullish Ready",
     "Market Tradability Engine v2: compression with bullish acceptance pressure near the upper boundary."
)

alertcondition(
     bearishReadyEvent,
     "MTE2: Bearish Ready",
     "Market Tradability Engine v2: compression with bearish acceptance pressure near the lower boundary."
)

alertcondition(
     bullishBreakoutEvent,
     "MTE2: Bullish Breakout",
     "Market Tradability Engine v2: confirmed bullish breakout from the balance."
)

alertcondition(
     bearishBreakoutEvent,
     "MTE2: Bearish Breakout",
     "Market Tradability Engine v2: confirmed bearish breakout from the balance."
)

alertcondition(
     enteredTrend,
     "MTE2: Trend Confirmed",
     "Market Tradability Engine v2: the market has shifted into a tradable trend state."
)

alertcondition(
     enteredAftermath,
     "MTE2: Aftermath",
     "Market Tradability Engine v2: a recent impulse has gone quiet - avoid chasing until new structure forms."
)

alertcondition(
     enteredExhaustion,
     "MTE2: Exhaustion",
     "Market Tradability Engine v2: the current trend shows overextension or declining quality."
)

alertcondition(
     bullishFailedBreakoutEvent,
     "MTE2: Failed Bullish Breakout",
     "Market Tradability Engine v2: price swept above the armed balance boundary but was rejected back into the range."
)

alertcondition(
     bearishFailedBreakoutEvent,
     "MTE2: Failed Bearish Breakout",
     "Market Tradability Engine v2: price swept below the armed balance boundary but was rejected back into the range."
)

// ----------------------------------------------------------------------------
// Optional dynamic aggregate alerts
// ----------------------------------------------------------------------------

if enableDynamicAlerts and barstate.isconfirmed
    if enteredNoTrade
        alert(
             "MTE2 | NO TRADE | Structure: " +
             str.tostring(structureScore, "#") +
             " | Energy: " +
             str.tostring(energyScore, "#"),
             alert.freq_once_per_bar_close
        )

    if bullishReadyEvent or bearishReadyEvent
        alert(
             "MTE2 | READY | Acceptance: " +
             f_acceptanceText(acceptanceScore) +
             " | Energy: " +
             str.tostring(energyScore, "#"),
             alert.freq_once_per_bar_close
        )

    if bullishBreakoutEvent or bearishBreakoutEvent
        alert(
             "MTE2 | BREAKOUT | Acceptance: " +
             f_acceptanceText(acceptanceScore) +
             " | Energy: " +
             str.tostring(energyScore, "#"),
             alert.freq_once_per_bar_close
        )

    if enteredAftermath
        alert(
             "MTE2 | AFTERMATH | Acceptance: " +
             f_acceptanceText(acceptanceScore) +
             " | Energy: " +
             str.tostring(energyScore, "#"),
             alert.freq_once_per_bar_close
        )

    if bullishFailedBreakoutEvent or bearishFailedBreakoutEvent
        alert(
             "MTE2 | FAILED BREAKOUT | Direction: " +
             (
                 bullishFailedBreakoutEvent ?
                 "UP" :
                 "DOWN"
             ) +
             " | Acceptance: " +
             f_acceptanceText(acceptanceScore) +
             " | Upper tests: " +
             str.tostring(upperBoundaryTests) +
             " | Lower tests: " +
             str.tostring(lowerBoundaryTests),
             alert.freq_once_per_bar_close
        )
