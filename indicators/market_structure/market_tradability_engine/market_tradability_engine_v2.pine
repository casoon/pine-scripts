     "Balanced",
     "Preset",
     options = [
         "Very Fast",
         "Fast",
         "Balanced",
         "Calm",
         "Position",
         "Custom"
     ],
     group = groupPreset,
     tooltip = "Controls lookback lengths (how many bars feed each calculation)."
)

string reactivity = input.string(
     "Balanced",
     "Reactivity",
     options = [
         "Early",
         "Balanced",
         "Conservative",
         "Custom"
     ],
     group = groupPreset,
     tooltip = "Controls how readily a state change triggers: thresholds and confirmation/" +
          "duration bars. 'Early' reacts sooner off softer evidence (more state changes, " +
          "more false starts); 'Conservative' waits for stronger, more sustained evidence. " +
          "Independent of Preset, which only controls lookback lengths."
)

