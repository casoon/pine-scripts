---
import {
  AudienceList,
  Badge,
  Badges,
  Button,
  CodeBlock,
  ElementList,
  Faq,
  Hero,
  Quickstart,
  SectionIntro,
  Split,
  StatBand,
  Tradeoffs,
} from '@casoon/pages-theme/components';
import Base from '@casoon/pages-theme/layouts/Base.astro';
import { url } from '@casoon/pages-theme/url';
import { listFiles, loadCatalog, loadIndicators, readRepoFile } from '../repo';
// Real TradingView chart from the repository:
// indicators/trend_direction/smooth_trend_radar/smooth_trend_radar_1.png, converted to WebP
// and cropped to its right half (the last flips and the SL/TP levels of the last one) so
// the labels stay legible; the narrow file is a tighter crop of the same chart for phones.
import chartNarrow from '../assets/smooth-trend-radar-narrow.webp?url';
import chart from '../assets/smooth-trend-radar.webp?url';

// Every figure on this page is counted from the repository at build time.
const indicators = loadIndicators();
const published = indicators.filter((indicator) => indicator.tradingView).length;
const scripts = listFiles('indicators', (path) => path.endsWith('.pine'));
const contracts = scripts.filter((path) => /^\/\/ Data Contract:/m.test(readRepoFile(path))).length;
const catalog = [...loadCatalog().values()];
const untested = catalog.filter((entry) => entry.tested === 'not yet' || entry.tested === 'barely').length;
const strategies = listFiles('strategies', (path) => path.endsWith('.pine')).length;

const contractExample = `// Data Contract:
//   Price:     REQUIRED   chart symbol
//   Volume:    OPTIONAL   real trade volume only
//   OI:        NO
//   Reference: NO
//   Verdict:   CFD-degraded`;

const alertFormat = `<code> · <event> · {{ticker}} {{interval}}

CPM4 · WATCH LONG · {{ticker}} {{interval}}
CPM4 · LONG · {{ticker}} {{interval}}`;

---

<Base>
  <Hero
    title="Pine Script indicators, checked against the data they run on."
    lead="TradingView indicators and strategies in Pine Script v6 for market structure, trend, momentum and confluence. Most are drafts. What they share: each script says which data it needs, and whether that data means anything on your instrument."
  >
    <Badges>
      <Badge tone="brand">Experimental</Badge>
      <Badge>MIT</Badge>
      <Badge>Pine Script v6</Badge>
    </Badges>
    <div class="cta">
      <Button href={url('docs/getting-started/indicators/')}>Browse the catalog</Button>
      <Button href={url('docs/')} variant="secondary">Documentation</Button>
    </div>
    <figure slot="output" class="chart">
      <picture>
        <source media="(max-width: 640px)" srcset={chartNarrow} width="762" height="480" />
        <img
          src={chart}
          width="922"
          height="520"
          alt="Excerpt of a TradingView chart of Natural Gas (XNGUSD, Capital.com), 1 hour, mid to late April, with the Smooth Trend Radar indicator: a smoothed baseline that turns teal in uptrends and red in downtrends, triangle labels at trend flips and baseline rejections, and for the last flip a short setup with entry at 2.7766, stop loss at 2.8249 and three take-profit levels down to 2.6615, with shaded risk and reward zones."
        />
      </picture>
      <figcaption>
        <a class="inline" href={url('docs/trend-direction/smooth-trend-radar/')}>Smooth Trend Radar</a>{' '}
        on Natural Gas, 1h: flip and rejection labels, SL/TP levels of the last flip.
      </figcaption>
    </figure>
  </Hero>

  <StatBand
    label="The repository in numbers"
    items={[
      { value: String(indicators.length), label: 'indicators, each with its own page' },
      { value: String(contracts), label: 'scripts with a declared Data Contract' },
      { value: `${untested} of ${catalog.length}`, label: 'catalogued, not or barely checked on real charts' },
      { value: String(published), label: 'published on TradingView' },
    ]}
  />

  <SectionIntro
    title="Not many indicators. A few habits."
    lead="The maths of an indicator is rarely the problem. The problem is feeding it data that carries no signal, such as tick volume read as trade volume."
  />

  <Split
    index="01"
    eyebrow="Data"
    title="Volume only counts when it is volume."
    lead="A volume series exists on almost every chart. Whether it is traded volume depends on the symbol. Scripts read that from syminfo.volumetype and switch volume parts off visibly when it is missing."
    links={[{ label: 'Data validity', href: url('docs/concepts/data-validity/') }]}
  >
    <ElementList
      items={[
        { term: 'base / quote', body: 'Real traded volume. Volume-based parts stay on.' },
        { term: 'tick / n/a', body: 'Not traded volume. Those parts switch off and the remaining weights are renormalised.' },
      ]}
    />
  </Split>

  <Split
    index="02"
    reverse
    eyebrow="Header"
    title="The Data Contract tells you before you add it."
    lead="Every script header lists the data it needs (price, volume, open interest, a reference market) and ends in one verdict."
    points={[
      '**CFD-safe:** runs on a CFD as designed.',
      '**CFD-degraded:** runs on a CFD, with some parts off.',
      '**Reference-required:** needs a reference market to mean anything.',
      '**Exchange-only:** needs real exchange data.',
    ]}
  >
    <CodeBlock
      code={contractExample}
      lang="text"
      title="Header of a .pine file"
    />
  </Split>

  <Split
    index="03"
    eyebrow="Design"
    title="One job per indicator."
    lead="An indicator measures one thing: structure, trend strength, exhaustion. Composites combine those roles openly and show which part drives the reading."
  >
    <ElementList
      items={[
        { term: 'Alerts', body: 'Named conditions with stable titles and codes, one message format, fired on bar close.' },
        { term: 'Strategies', body: `${strategies} standalone wrappers with confirmed-bar entries and a warning on Heikin Ashi, Renko and other synthetic charts.` },
      ]}
    />
  </Split>

  <AudienceList
    heading="Who this is for"
    items={[
      { title: 'Pine authors', body: 'Structure, headers and alert conventions you can copy, and a record of what went wrong.' },
      { title: 'Chart readers', body: 'Context for a chart: structure, trend, momentum. Not a trade list.' },
      { title: 'CFD traders', body: 'Scripts that say what survives on a CFD without exchange volume.' },
    ]}
  />

  <Tradeoffs
    eyebrow="Read this first"
    title="Experimental, and not advice"
    lead="The scripts are for learning and chart analysis."
    items={[
      'Many are drafts that have not been checked on real charts; quality varies.',
      'No page here claims a signal is profitable, and a backtest says nothing about future results.',
      'Trading carries a substantial risk of loss. Decisions and their consequences are yours.',
    ]}
  />

  <Quickstart
    lead="From choosing an indicator to a first alert. The documentation walks through each step."
    steps={[
      'Pick an indicator by the question you want answered, from the catalog.',
      'Read its Data Contract in the header or the README.',
      'Paste the <code>.pine</code> file into the Pine Editor, or add the published version.',
      'Create an alert from its named conditions.',
    ]}
  >
    <CodeBlock code={alertFormat} title="Alert message format" label="text" />
  </Quickstart>

  <Faq
    items={[
      {
        q: 'How do I use one of the indicators?',
        a: 'Open its .pine file and copy the contents. In TradingView: Pine Editor → paste → Add to chart.',
      },
      {
        q: 'Are the strategies ready to trade?',
        a: 'No. Each strategy under strategies/ is standalone and hand-maintained. Its status, for example "Promising" or "Not ready: not yet backtested", is in the README and its assessment file.',
      },
      {
        q: 'Why do some indicators lose parts on my chart?',
        a: 'Their data check found no real volume or reference market on the symbol. The affected parts switch off visibly instead of producing a number that looks fine.',
      },
    ]}
  />
</Base>

<style>
  .notice {
    max-width: var(--max);
    margin: 0 auto 32px;
    padding: 0 24px;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
  }
  .chart {
    margin: 0;
  }
  .chart img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: 12px;
  }
  .chart figcaption {
    margin-top: 10px;
    color: var(--muted);
    font-size: 13.5px;
  }
  .chart .inline {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
