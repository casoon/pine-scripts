---
import { readFile } from 'node:fs/promises';
import {
  Badge,
  Badges,
  Button,
  Callout,
  CodeBlock,
  Facts,
  Faq,
  Features,
  Hero,
  Quickstart,
  ReleaseHighlights,
} from '@casoon/pages-theme/components';
import Base from '@casoon/pages-theme/layouts/Base.astro';
import config from 'virtual:casoon-pages/config';
import { parseChangelog } from '@casoon/pages-theme/lib/changelog';
import { url } from '@casoon/pages-theme/lib/url';
import { listFiles, loadCatalog, loadIndicators, readRepoFile } from '../repo';
// Real TradingView chart from the repository:
// indicators/trend_direction/smooth_trend_radar/smooth_trend_radar_1.png, converted to WebP
// and cropped to its right half (the last flips and the SL/TP levels of the last one) so
// the labels stay legible; the narrow file is a tighter crop of the same chart for phones.
import chartNarrow from '../assets/smooth-trend-radar-narrow.webp?url';
import chart from '../assets/smooth-trend-radar.webp?url';

// Every figure on this page is counted from the repository at build time.
const indicators = loadIndicators();
const published = indicators.filter((indicator) => indicator.tradingView).length;
const scripts = listFiles('indicators', (path) => path.endsWith('.pine'));
const contracts = scripts.filter((path) => /^\/\/ Data Contract:/m.test(readRepoFile(path))).length;
const catalog = [...loadCatalog().values()];
const untested = catalog.filter((entry) => entry.tested === 'not yet' || entry.tested === 'barely').length;
const strategies = listFiles('strategies', (path) => path.endsWith('.pine')).length;

const alertFormat = `<code> · <event> · {{ticker}} {{interval}}

CPM4 · WATCH LONG · {{ticker}} {{interval}}
CPM4 · LONG · {{ticker}} {{interval}}`;

// Skip "Unreleased": it has no version to show as "New in v…" yet.
const latestRelease = config.changelog
  ? parseChangelog(await readFile(config.changelog, 'utf8')).find(
      (r) => r.version.toLowerCase() !== 'unreleased'
    )
  : undefined;
---

<Base>
  <Hero
    title="Experiments in technical analysis, written in Pine Script."
    lead="A loose collection of TradingView indicators and strategies in Pine Script v6 for market structure, trend, momentum and confluence. Most of it is unfinished. One habit runs through all of it: checking whether a script's inputs carry a signal on the instrument it runs on, not only whether its maths is correct."
  >
    <Badges>
      <Badge tone="brand">Experimental</Badge>
      <Badge>MIT</Badge>
      <Badge>Pine Script v6</Badge>
      <Badge>TradingView</Badge>
    </Badges>
    <div class="cta">
      <Button href={url('docs/getting-started/indicators/')}>Catalog</Button>
      <Button href={url('docs/')} variant="secondary">Documentation</Button>
    </div>
    <figure slot="output" class="chart">
      <picture>
        <source media="(max-width: 640px)" srcset={chartNarrow} width="762" height="480" />
        <img
          src={chart}
          width="922"
          height="520"
          alt="Excerpt of a TradingView chart of Natural Gas (XNGUSD, Capital.com), 1 hour, mid to late April, with the Smooth Trend Radar indicator: a smoothed baseline that turns teal in uptrends and red in downtrends, triangle labels at trend flips and baseline rejections, and for the last flip a short setup with entry at 2.7766, stop loss at 2.8249 and three take-profit levels down to 2.6615, with shaded risk and reward zones."
        />
      </picture>
      <figcaption>
        <a class="inline" href={url('docs/trend-direction/smooth-trend-radar/')}>Smooth Trend Radar</a>{' '}
        on Natural Gas, 1h: baseline, flip and rejection labels, SL/TP levels of the last flip.
      </figcaption>
    </figure>
  </Hero>

  <div class="notice">
  <Callout type="caution" title="Experimental, not advice">
    <p>
      These scripts are for learning and chart analysis. They do not recommend any trade, no page
      here claims a signal is profitable, and a backtest says nothing about future results. Many
      indicators are drafts that have not been checked on real charts, and quality varies widely.
      Trading involves substantial risk of loss; decisions and their consequences are your own.
    </p>
  </Callout>
  </div>

  <Facts
    items={[
      { value: String(indicators.length), label: 'indicator directories, each with its own page' },
      { value: String(contracts), label: 'scripts with a declared Data Contract so far' },
      { value: `${untested} of ${catalog.length}`, label: 'catalogued indicators not, or barely, checked on real charts' },
      { value: String(published), label: 'scripts published on TradingView' },
    ]}
  />

  <Features
    items={[
      {
        title: 'Data before maths',
        body: 'Whether volume is trade volume comes from syminfo.volumetype, not from the existence of a volume series. Without it, volume parts switch off visibly and the remaining weights are renormalised.',
      },
      {
        title: 'A Data Contract in the header',
        body: 'Scripts state which data they need — price, volume, open interest, a reference market — and a verdict: CFD-degraded, Reference-required or Exchange-only.',
      },
      {
        title: 'One role per indicator',
        body: 'An indicator measures one thing: structure, trend strength, exhaustion. Composite indicators combine roles explicitly and show which part drives the reading.',
      },
      {
        title: 'Alerts that keep working',
        body: 'Named conditions with stable titles and codes, one message format, and a bar-close gate so an alert does not fire on a forming bar and vanish.',
      },
      {
        title: `${strategies} strategy wrappers`,
        body: 'Standalone strategies for the Strategy Tester, with confirmed-bar entries and a guard that warns on Heikin Ashi, Renko and other synthetic chart types.',
      },
    ]}
  />

  <Quickstart
    lead="From choosing an indicator to a first alert. The walkthrough in the documentation covers each step."
    steps={[
      'Pick an indicator by the question you want answered, from the index or the sidebar.',
      'Check its data requirements: the Data Contract in the header, or the README.',
      'Paste the <code>.pine</code> file into the Pine Editor, or add the published version on TradingView.',
      'Create an alert from its named conditions; messages carry a stable code per indicator.',
    ]}
  >
    <CodeBlock code={alertFormat} title="Alert message format" label="text" />
  </Quickstart>

  {latestRelease && <ReleaseHighlights release={latestRelease} />}

  <Faq
    items={[
      {
        q: 'What is this repository exactly?',
        a: 'A running collection of experimental TradingView indicators and strategies in Pine Script v6, not a finished product catalog. Quality is treated as an ongoing process, including whether an indicator’s inputs carry a real signal on the instrument it runs on.',
      },
      {
        q: 'How do I use one of the indicators?',
        a: 'Open the .pine file for the indicator you want, copy its contents, then in TradingView use Pine Script Editor → Paste → Add to Chart.',
      },
      {
        q: 'What does the "Data Contract" in a script header mean?',
        a: 'It states which data the indicator needs — price, volume, open interest or a reference market — and gives a verdict: CFD-degraded, Reference-required or Exchange-only, so you know whether it fits your instrument before adding it.',
      },
      {
        q: 'Are the strategies ready to trade?',
        a: 'No single status applies to all of them. Each strategy under strategies/ is standalone and hand-maintained, and its status — for example "Promising" or "Not ready — not yet backtested" — is listed in the README and its own assessment file.',
      },
      {
        q: 'Is anything here financial advice?',
        a: 'No. The scripts are for learning and chart analysis, no page claims a signal is profitable, and a backtest says nothing about future results. Trading involves substantial risk of loss.',
      },
    ]}
  />
</Base>

<style>
  .notice {
    max-width: var(--max);
    margin: 0 auto 32px;
    padding: 0 24px;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
  }
  .chart {
    margin: 0;
  }
  .chart img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: 12px;
  }
  .chart figcaption {
    margin-top: 10px;
    color: var(--muted);
    font-size: 13.5px;
  }
  .chart .inline {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
